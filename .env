# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
POSTGRES_VERSION=16
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

DATABASE_URL=
###< doctrine/doctrine-bundle ###

UID=1000
GID=1000

###> symfony/mailer ###
MAILER_DSN=
MAILER_FROM_ADDRESS=contact@nidemiel.com
MAILER_FROM_NAME=Nidemiel
###< symfony/mailer ###

###> app ###
APP_SITE_NAME=Nidemiel
###< app ###

###> stripe/stripe-php ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
###< stripe/stripe-php ###

###> karser/karser-recaptcha3-bundle ###
RECAPTCHA3_KEY=
RECAPTCHA3_SECRET=
###< karser/karser-recaptcha3-bundle ###

###> knpuniversity/oauth2-client-bundle ###
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
###< knpuniversity/oauth2-client-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async
###< symfony/messenger ###

###> transporteurs ###
# Colissimo (La Poste) — définir dans .env.dev.local ou .env.prod.local
COLISSIMO_LOGIN=
COLISSIMO_PASSWORD=
COLISSIMO_SENDER_NAME=
COLISSIMO_SENDER_STREET=
COLISSIMO_SENDER_ZIP=
COLISSIMO_SENDER_CITY=
###< transporteurs ###

###> backup/rclone ###
# OVH Object Storage S3 — définir les vraies valeurs dans .env.prod.local
RCLONE_S3_ACCESS_KEY=
RCLONE_S3_SECRET_KEY=
RCLONE_S3_ENDPOINT=s3.eu-west-par.io.cloud.ovh.net
RCLONE_S3_REGION=eu-west-par
RCLONE_S3_BUCKET=nidemiel-backups
###< backup/rclone ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
# 0.0 = désactivé, 0.1 = 10% des requêtes tracées (recommandé en prod)
SENTRY_TRACES_SAMPLE_RATE=0.1
###< sentry/sentry-symfony ###
