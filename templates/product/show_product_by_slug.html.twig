{% extends 'base.html.twig' %}

{% block stylesheets %}
	{# Préchargement LCP : image principale du produit #}
	{% if product.medias|length > 0 %}
	<link rel="preload" as="image" href="/assets/images/products/{{ product.medias[0].mediumFilename }}" fetchpriority="high">
	{% endif %}

	{# CSS non-critiques — différés pour ne pas bloquer le rendu #}
	<link rel="stylesheet" href="/assets/css/slick.css" media="print" onload="this.media='all'">
	<link rel="stylesheet" href="/assets/css/slick-theme.css" media="print" onload="this.media='all'">
	<link rel="stylesheet" href="/assets/css/magnific-popup.css" media="print" onload="this.media='all'">
	<noscript>
		<link rel="stylesheet" href="/assets/css/slick.css">
		<link rel="stylesheet" href="/assets/css/slick-theme.css">
		<link rel="stylesheet" href="/assets/css/magnific-popup.css">
	</noscript>
{% endblock %}

{% block page_scripts %}
	<script src="/assets/js/slick.min.js" defer></script>
	<script src="/assets/js/jquery.elevatezoom.js" defer></script>
	<script src="/assets/js/magnific-popup.min.js" defer></script>
	<script>
	document.querySelectorAll('.stock-alert-form').forEach(function(form) {
		form.addEventListener('submit', function(e) {
			e.preventDefault();
			var action   = form.dataset.action;
			var feedback = form.closest('.stock-alert-box').querySelector('.stock-alert-feedback');
			var data     = new FormData(form);

			fetch(action, { method: 'POST', body: data })
				.then(function(r) { return r.json(); })
				.then(function(json) {
					feedback.textContent = json.message || json.error || '';
					feedback.className   = 'stock-alert-feedback small mt-1 ' + (json.error ? 'text-danger' : 'text-success');
					if (!json.error) { setTimeout(function() { location.reload(); }, 1500); }
				})
				.catch(function() { feedback.textContent = 'Une erreur est survenue.'; });
		});
	});
	</script>
{% endblock %}

{% block title %}{{ globalSetting.website_name }} | {{ product.title }}{% endblock %}

{% block meta_description %}Découvrez {{ product.title }} — {{ product.description|striptags|slice(0, 150) }}{% endblock %}

{% set link_canonical = app.request.uri %}

{% block body %}

	{% set firstCategory = product.categories|first %}
	{% include 'page_head/index.html.twig' with {
		page_name: product.title,
		breadcrumbs: firstCategory ? [
			{
				label: firstCategory.title,
				url: path('app_category', { categoryName: firstCategory.slug })
			},
			{ label: product.title }
		] : [
			{ label: product.title }
		]
	} %}

	<main id="main-content">
		<div class="nide-product-page">
			<div class="container">

				{# ── Fiche produit : galerie + infos ── #}
				<div class="nide-product">

					{# Galerie #}
					<div class="nide-product__gallery">
						{% set mainMedia = product.medias|first %}
						<div class="nide-product__main-img">
							<img
								id="product_img"
								alt="{{ mainMedia ? mainMedia.alt : product.title }}"
								src="{{ mainMedia ? '/assets/images/products/' ~ mainMedia.mediumFilename : '/assets/images/placeholder.png' }}"
								data-zoom-image="{{ mainMedia ? '/assets/images/products/' ~ mainMedia.filename : '' }}"
								width="800" height="800"
								fetchpriority="high"
								loading="eager"
								decoding="async"
							>
							{% if mainMedia %}
							<a href="/assets/images/products/{{ mainMedia.filename }}" title="Zoom" class="nide-product__zoom product_img_zoom" aria-label="Agrandir l'image">
								<svg class="icon" aria-hidden="true"><use href="#icon-zoom-in"></use></svg>
							</a>
							{% endif %}
						</div>

						{% if product.medias|length > 1 %}
						<div id="pr_item_gallery" data-slides-to-show="4" data-slides-to-scroll="1" data-infinite="false" class="nide-product__thumbs product_gallery_item slick_slider">
							{% for image in product.medias %}
								<div class="nide-product__thumb-item">
									<a href="javascript:void(0)"
									   class="product_gallery_item {% if loop.first %}active{% endif %}"
									   data-image="/assets/images/products/{{ image.mediumFilename }}"
									   data-zoom-image="/assets/images/products/{{ image.filename }}"
									   aria-label="Image {{ loop.index }} — {{ image.alt ?: product.title }}">
										<img alt="" src="/assets/images/products/{{ image.thumbnailFilename }}" width="90" height="90" loading="lazy" decoding="async">
									</a>
								</div>
							{% endfor %}
						</div>
						{% endif %}
					</div>

					{# Infos produit #}
					<div class="nide-product__info">

						{# H1 + accroche #}
						<h1 class="nide-product__title">{{ product.title }}</h1>

						{% if product.accroche %}
						<p class="nide-product__accroche">{{ product.accroche }}</p>
						{% endif %}

						{% if averageRating is not null %}
						<div class="nide-product__rating">
							<div class="nide-product__stars">
								<div class="nide-product__stars-fill" style="width: {{ ((averageRating / 5) * 100)|round }}%;"></div>
							</div>
							<span class="nide-product__rating-label">{{ averageRating }}/5 · {{ product.approvedReviewsCount }} avis</span>
						</div>
						{% endif %}

						{# Prix #}
						<div class="nide-product__price">
							{% if product.isOnSale %}
								<span class="nide-product__price-current">{{ (product.soldePrice / 100)|number_format(2, ',', ' ') }}&nbsp;€</span>
								<span class="nide-product__price-old">{{ (product.regularPrice / 100)|number_format(2, ',', ' ') }}&nbsp;€</span>
								<span class="nide-product__badge">-{{ product.discountPercentage }}&nbsp;%</span>
							{% else %}
								<span class="nide-product__price-current">{{ (product.regularPrice / 100)|number_format(2, ',', ' ') }}&nbsp;€</span>
							{% endif %}
						</div>

						{# Bloc réassurance produit (additionalInfos) — rendu en paires Clé : Valeur #}
						{% if product.weightGrams or product.additionalInfos %}
						<div class="nide-product__attrs">
							{% if product.weightGrams %}
							<div class="nide-product__attr">
								<span class="nide-product__attr-key">Poids net</span>
								<span class="nide-product__attr-val">
									{% if product.weightGrams >= 1000 %}
										{{ (product.weightGrams / 1000)|number_format(1, ',') }}&nbsp;kg
									{% else %}
										{{ product.weightGrams }}&nbsp;g
									{% endif %}
								</span>
							</div>
							{% endif %}
							{% if product.additionalInfos %}
								{% set raw = product.additionalInfos
									|replace({'<br>': '\n', '<br/>': '\n', '<br />': '\n', '</p>': '\n', '</li>': '\n', '&nbsp;': ' '})
									|striptags %}
								{% for line in raw|split('\n') %}
									{% set line = line|trim %}
									{% if ':' in line %}
										{% set parts = line|split(':', 2) %}
										<div class="nide-product__attr">
											<span class="nide-product__attr-key">{{ parts[0]|trim }}</span>
											<span class="nide-product__attr-val">{{ parts[1]|trim }}</span>
										</div>
									{% elseif line is not empty %}
										<div class="nide-product__attr nide-product__attr--full">{{ line }}</div>
									{% endif %}
								{% endfor %}
							{% endif %}
						</div>
						{% endif %}

						{# Garanties génériques #}
						<ul class="nide-product__reassurance">
							<li>
								<svg class="icon" aria-hidden="true"><use href="#icon-shield"></use></svg>
								Produit certifié
							</li>
							<li>
								<svg class="icon" aria-hidden="true"><use href="#icon-truck"></use></svg>
								Livraison partout en France
							</li>
							<li>
								<svg class="icon" aria-hidden="true"><use href="#icon-refresh"></use></svg>
								Retour sous 30 jours
							</li>
							<li>
								<svg class="icon" aria-hidden="true"><use href="#icon-lock"></use></svg>
								Paiement sécurisé
							</li>
						</ul>

						<div class="nide-product__divider"></div>

						{# Stock #}
						{% set inStock = availableStock is null or availableStock > 0 %}
						<div class="nide-product__stock">
							{% if inStock %}
								<span class="nide-product__stock-badge nide-product__stock-badge--in">
									<svg class="icon" aria-hidden="true"><use href="#icon-check"></use></svg>
									En stock{% if availableStock is not null %} ({{ availableStock }}){% endif %}
								</span>
							{% else %}
								<span class="nide-product__stock-badge nide-product__stock-badge--out">
									<svg class="icon" aria-hidden="true"><use href="#icon-x"></use></svg>
									Rupture de stock
								</span>
							{% endif %}
						</div>

						{# CTA #}
						{% if inStock %}
						<div class="nide-product__cta">
							<div class="nide-product__qty">
								<input type="button" value="-" class="minus" aria-label="Diminuer la quantité">
								<input type="text" name="quantity" value="1" aria-label="Quantité" size="4" class="qty" {% if availableStock is not null %}data-max="{{ availableStock }}"{% endif %}>
								<input type="button" value="+" class="plus" aria-label="Augmenter la quantité">
							</div>
							<a href="/cart/add/{{ product.id }}/1" class="btn btn-fill-out btn-addtocart">
								<svg class="icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
								Ajouter au panier
							</a>
							<a href="/checkout" class="btn btn-fill-line nide-product__checkout">
								<svg class="icon" aria-hidden="true"><use href="#icon-credit-card"></use></svg>
								Payer maintenant
							</a>
							<a href="/cart" class="btn btn-fill-line nide-product__checkout">
								<svg class="icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
								Voir mon panier
							</a>
						</div>
						{% else %}
						<div class="nide-product__cta">
							<button class="btn btn-light" disabled>
								<svg class="icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
								Indisponible
							</button>
						</div>
						<div class="stock-alert-box nide-product__alert">
							{% set userEmail = app.user ? app.user.email : null %}
							{% if stockAlertSubscribed %}
								<p class="nide-product__alert-msg nide-product__alert-msg--ok">
									<svg class="icon" aria-hidden="true"><use href="#icon-check"></use></svg>
									Vous serez alerté dès le retour en stock.
								</p>
								<form class="stock-alert-form" data-action="{{ path('app_stock_alert_unsubscribe', { id: product.id }) }}" data-mode="unsubscribe">
									<input type="hidden" name="email" value="{{ userEmail ?? '' }}">
									<button type="submit" class="btn btn-sm btn-outline-secondary">Annuler l'alerte</button>
								</form>
							{% else %}
								<p class="nide-product__alert-msg">Recevez un e-mail dès que ce produit est disponible.</p>
								<form class="stock-alert-form nide-product__alert-form" data-action="{{ path('app_stock_alert_subscribe', { id: product.id }) }}" data-mode="subscribe">
									{% if not app.user %}
										<input type="email" name="email" class="form-control form-control-sm" placeholder="votre@email.fr" required>
									{% else %}
										<input type="hidden" name="email" value="{{ userEmail }}">
									{% endif %}
									<button type="submit" class="btn btn-sm btn-outline-dark">
										<svg class="icon" aria-hidden="true"><use href="#icon-bell"></use></svg>
										M'alerter
									</button>
								</form>
							{% endif %}
							<div class="stock-alert-feedback small mt-1"></div>
						</div>
						{% endif %}

						{# Actions secondaires #}
						<div class="nide-product__actions">
							<a href="/compare/add/{{ product.id }}" class="nide-product__action add-to-compare" aria-label="Ajouter {{ product.title }} au comparatif">
								<svg class="icon" aria-hidden="true"><use href="#icon-shuffle"></use></svg>
								Comparer
							</a>
							<a href="/wishlist/add/{{ product.id }}" class="nide-product__action add-to-wishlist" aria-label="Ajouter {{ product.title }} à la liste de souhaits">
								<svg class="icon" aria-hidden="true"><use href="#icon-heart"></use></svg>
								Favoris
							</a>
						</div>

						<div class="nide-product__divider"></div>

						{# Méta + partage #}
						<div class="nide-product__meta">
							{% if product.categories|length > 0 %}
							<span class="nide-product__meta-label">Catégorie :</span>
							{% for category in product.categories %}
								<a href="/product/category/{{ category.slug }}" class="nide-product__meta-link">{{ category }}</a>{% if not loop.last %}, {% endif %}
							{% endfor %}
							{% endif %}
						</div>

						<div class="nide-product__share">
							<span class="nide-product__share-label">Partager :</span>
							<ul class="nide-product__share-list">
								<li>
									<a href="https://www.facebook.com/sharer/sharer.php?u={{ app.request.uri|url_encode }}" aria-label="Partager sur Facebook" rel="noopener" target="_blank">
										<svg class="icon" aria-hidden="true"><use href="#icon-facebook"></use></svg>
									</a>
								</li>
								<li>
									<a href="https://twitter.com/intent/tweet?url={{ app.request.uri|url_encode }}&text={{ product.title|url_encode }}" aria-label="Partager sur X (Twitter)" rel="noopener" target="_blank">
										<svg class="icon" aria-hidden="true"><use href="#icon-twitter"></use></svg>
									</a>
								</li>
								<li>
									<a href="https://www.instagram.com/" aria-label="Voir sur Instagram" rel="noopener" target="_blank">
										<svg class="icon" aria-hidden="true"><use href="#icon-instagram"></use></svg>
									</a>
								</li>
							</ul>
						</div>

					</div>{# /nide-product__info #}
				</div>{# /nide-product #}

				{# ── Onglets ── #}
				<div class="nide-product__tabs">
					<div class="tab-style3">
						<ul role="tablist" class="nav nav-tabs">
							<li class="nav-item" role="presentation">
								<a id="Description-tab" data-bs-toggle="tab" href="#Description" role="tab" aria-controls="Description" aria-selected="true" class="nav-link active">Description</a>
							</li>
							{% if product.moreDescription %}
							<li class="nav-item" role="presentation">
								<a id="Additional-info-tab" data-bs-toggle="tab" href="#Additional-info" role="tab" aria-controls="Additional-info" aria-selected="false" class="nav-link">Plus d'infos</a>
							</li>
							{% endif %}
							<li class="nav-item" role="presentation">
								<a id="Reviews-tab" data-bs-toggle="tab" href="#Reviews" role="tab" aria-controls="Reviews" aria-selected="false" class="nav-link">Avis</a>
							</li>
						</ul>
						<div class="tab-content shop_info_tab">
							<div id="Description" role="tabpanel" aria-labelledby="Description-tab" class="tab-pane fade show active">
								<div class="nide-page-content">{{ product.description|normalize_editor_html|raw }}</div>
							</div>
							{% if product.moreDescription %}
							<div id="Additional-info" role="tabpanel" aria-labelledby="Additional-info-tab" class="tab-pane fade">
								<div class="nide-page-content">{{ product.moreDescription|normalize_editor_html|raw }}</div>
							</div>
							{% endif %}
							<div id="Reviews" role="tabpanel" aria-labelledby="Reviews-tab" class="tab-pane fade">
								{% include 'product/_reviews.html.twig' %}
							</div>
						</div>
					</div>
				</div>

				{# ── Produits liés ── #}
				{% if relatedProducts is not empty %}
				<div class="nide-product__related">
					<h2 class="nide-product__related-title">Vous apprécierez également</h2>
					<div class="row shop_container">
						{% for related in relatedProducts %}
							{% include "product/display_product.html.twig" with { product: related } only %}
						{% endfor %}
					</div>
				</div>
				{% endif %}

			</div>
		</div>
	</main>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
	const qtyInput = document.querySelector('input.qty');
	if (!qtyInput) return;

	function syncCartLink(qty) {
		const link = document.querySelector('.btn-addtocart');
		if (link) {
			link.href = '/cart/add/{{ product.id }}/' + qty;
		}
	}

	qtyInput.addEventListener('change', function () {
		syncCartLink(parseInt(this.value, 10) || 1);
	});

	document.addEventListener('click', function (e) {
		if (e.target.classList.contains('plus') || e.target.classList.contains('minus')) {
			setTimeout(function () {
				syncCartLink(parseInt(qtyInput.value, 10) || 1);
			}, 0);
		}
	});

	// Zoom image : suit la position du curseur
	const zoomBox = document.querySelector('.nide-product__main-img');
	if (zoomBox) {
		zoomBox.addEventListener('mousemove', function (e) {
			const rect = zoomBox.getBoundingClientRect();
			const x = ((e.clientX - rect.left) / rect.width  * 100).toFixed(2);
			const y = ((e.clientY - rect.top)  / rect.height * 100).toFixed(2);
			zoomBox.style.setProperty('--zoom-x', x + '%');
			zoomBox.style.setProperty('--zoom-y', y + '%');
		});
	}
});
</script>
{% endblock %}
