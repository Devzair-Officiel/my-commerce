{% extends 'base.html.twig' %}

{% block title %}{{globalSetting.website_name}} |
	{{product.title}}
{% endblock %}

{% block meta_description %}
	Découvrez nos produits bio en ligne, limitrophe
		et partout en France,
	{# {{ product.metaDescription }} #}
{% endblock %}

{% set link_canonical = app.request.uri %}

{% block body %}

	{% include "page_head/index.html.twig" with {'url': "/produits-bio-paris/category/" ~ product.categories[0].slug, 'page':
product.categories[0].slug, 'page_name': product.title } %}

	<div class="main_content">
		<div class="section">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-6 col-md-11 mb-4 mb-md-3">
						<div class="product-image">
							<div class="product_img_box"><img id="product_img" alt="image {{ product.title }}" src="/assets/images/products/{{ product.medias[0] }}"><a title="Zoom" class="product_img_zoom">
									<span class="linearicons-zoom-in"></span>
								</a>
							</div>
							<div id="pr_item_gallery" data-slides-to-show="4" data-slides-to-scroll="1" data-infinite="false" class="product_gallery_item slick_slider slick-initialized slick-slider">
								<div aria-live="polite" class="slick-list draggable">
									<div class="slick-track" role="listbox" style="opacity: 1; width: 556px; left: 0px;">
										{% for image in product.medias %}
											<div class="item slick-slide slick-current slick-active" data-slick-index="0" aria-hidden="false" tabindex="-1" role="option" aria-describedby="slick-slide20" style="width: 129px;">
												<a href="#" class="product_gallery_item active" data-image="/assets/images/products/{{ image }}" data-zoom-image="/assets/images/products/{{ image }}" tabindex="0"><img alt="product_small_img1" src="/assets/images/products/{{ image }}"></a>
											</div>
										{% endfor %}

									</div>
								</div>

							</div>
						</div>
					</div>
					<div class="col-lg-6 col-md-11">
						<div class="pr_detail">
							<div class="product_description">
								<h4 class="product_title">
									<a href="#">{{ product.title }}</a>
								</h4>
								<div class="product_price">
									<span class="price">{{ (product.soldePrice/100) |format_currency('EUR') }}</span>
									{# Ne pas afficher si le prix soldé est égale au prix régulier #}
									{% if product.regularPrice != product.soldePrice %}
										<del>{{ (product.regularPrice/100) | format_currency('EUR') }}</del>
										<div class="on_sale">
											<span>{{((product.regularPrice - product.soldePrice)*100/
                                        product.regularPrice) |number_format(2, '.', ',') }}% Off</span>
										</div>
									{% endif %}
								</div>
								{# <div class="rating_wrap">
																	{% set totalScoring = 0 %}
																	{% for opinion in opinions %}
																		{% set totalScoring = totalScoring + opinion.scoring %}
																	{% endfor %}
																	<div class="rating">
																		<div class="product_rate" style="width: {{ opinions|length > 0 ? ((totalScoring / opinions|length) / 5) * 100 : 0 }}%;"></div>
								
																	</div>
																	<span class="rating_num">({{ opinions|length }})</span>
																</div> #}
								<div class="pr_desc m-3">
									<p>{{ product.description | raw}}
									</p>
								</div>
								<div class="product_sort_info">
									<ul>
										<li>
											<i class="linearicons-shield-check"></i>
											Produit Certifié</li>
										<li>
											<i class="linearicons-map-marker"></i>
											et partout en France
										</li>
										<li>
											<i class="linearicons-sync"></i>
											Retour sous 30 jours
										</li>
										<li>
											<i class="linearicons-bag-dollar"></i>
											Paiement sécurisé
										</li>
									</ul>
								</div>
							</div>
							<hr>
							<div class="">
								<div class="cart-product-quantity">
									<div class="quantity">
										<input type="button" value="-" class="minus">
										<input type="text" name="quantity" value="1" title="Qty" size="4" class="qty">
										<input type="button" value="+" class="plus">
									</div>
								</div>
								<div class="cart_btn my-2">
									<a href="/cart/add/{{product.id}}/1" class="btn btn-fill-out btn-addtocart btn-no-margin">
										<i class="icon-basket-loaded"></i>
										Ajouter au panier
									</a>
									<a href="/checkout" class="btn btn-fill-out checkout btn-no-margin">
										<i class="icon-credit-card"></i>
										Payer maintenant
									</a>
								</div>
								<div class="cart_btn">
									<a href="/compare/add/{{product.id}}" class="add-to-compare">
										<i class="icon-shuffle"></i>
									</a>
									<a href="/wishlist/add/{{ product.id }}" class="add-to-wishlist mx-2">
										<i class="icon-heart"></i>
									</a>
								</div>
							</div>
							<hr>
							<ul class="product-meta">
								<li>
									Catégorie:
									{% for category in product.categories %}
										<a href="/product/category/{{category.slug}}">{{category}}
										</a>
									{% endfor %}
								</li>
							</ul>
							<div class="product_share">
								<span>Réseaux sociaux:</span>
								<ul class="social_icons">
									<li>
										<a href="#">
											<i class="ion-social-facebook"></i>
										</a>
									</li>
									<li>
										<a href="#">
											<i class="ion-social-twitter"></i>
										</a>
									</li>
									<li>
										<a href="#">
											<i class="ion-social-instagram-outline"></i>
										</a>
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="large_divider clearfix"></div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="tab-style3">
							<ul role="tablist" class="nav nav-tabs">
								<li class="nav-item">
									<a id="Description-tab" data-bs-toggle="tab" href="#Description" role="tab" aria-controls="Description" aria-selected="true" class="nav-link active">Description</a>
								</li>
								<li class="nav-item">
									<a id="Additional-info-tab" data-bs-toggle="tab" href="#Additional-info" role="tab" aria-controls="Additional-info" aria-selected="false" class="nav-link">Plus d'infos</a>
								</li>
								<li class="nav-item">
									<a id="Reviews-tab" data-bs-toggle="tab" href="#Reviews" role="tab" aria-controls="Reviews" aria-selected="false" class="nav-link">Avis</a>
								</li>
							</ul>
							<div class="tab-content shop_info_tab">
								<div id="Description" role="tabpanel" aria-labelledby="Description-tab" class="tab-pane fade show active">
									<div>{{ product.description | raw}}</div>
									<div style="border: 1px solid #e37e03; margin: 20px 25%"></div>
									<p style="font-size: 20px; text-align: center">
										Pour les achats de plusieurs kilos (Prix dégressif), appeler directement par téléphone.
									</p>
								</div>
								<div id="Additional-info" role="tabpanel" aria-labelledby="Additional-info-tab" class="tab-pane fade">
									{{ product.additionalInfos | raw }}
								</div>
								<div
									id="Reviews" role="tabpanel" aria-labelledby="Reviews-tab" class="tab-pane fade">{# {% include "opinion/index.html.twig" %} #}
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="small_divider"></div>
						<div class="divider"></div>
						<div class="medium_divider"></div>
					</div>
				</div>
				<div class="row shop_container">
					<h3 class="my-4">Les Best Seller</h3>
					{% for product in productBestSeller %}
						{% include "product/display_product.html.twig" %}
					{% endfor %}
				</div>
				<div class="row justify-content-center mt-4">

					<p class="col-9 text-center">
						Ce sont des produits d'exception qui traversent les frontières pour arriver à
												et partout en France. 
												                    Profitez des meilleurs
						<strong>miels</strong>,
						<strong>huiles</strong>
						et autres produits d'exception sur le marché actuellement.
					</p>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
