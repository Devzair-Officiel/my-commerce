<div class="reviews-section mt-4">

    {# --- Note moyenne --- #}
    {% if averageRating is not null %}
    <div class="rating_wrap mb-3">
        <div class="rating">
            <div class="product_rate" style="width: {{ ((averageRating / 5) * 100)|round }}%;"></div>
        </div>
        <span class="rating_num ms-2">
            {{ averageRating|number_format(1, ',') }}/5
            ({{ reviews|length }} avis{{ reviews|length > 1 ? 's' : '' }})
        </span>
    </div>
    {% else %}
    <p class="text-muted mb-3">Aucun avis pour ce produit.</p>
    {% endif %}

    {# --- Liste des avis approuvés --- #}
    {% if reviews|length > 0 %}
    <div class="reviews-list mb-4">
        {% for review in reviews %}
        <div class="review-item border rounded p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <div>
                    {# Masquer partiellement le nom : "Jean D." → "Jea* D." #}
                    {% set firstName = review.user.firstName ?? '' %}
                    {% set lastName  = review.user.lastName ?? '' %}
                    {% if firstName|length > 3 %}
                        {% set maskedFirst = firstName|slice(0, 3) ~ '*' %}
                    {% elseif firstName|length > 0 %}
                        {% set maskedFirst = firstName|slice(0, 1) ~ '*' %}
                    {% else %}
                        {% set maskedFirst = 'Anonyme' %}
                    {% endif %}
                    {% set maskedLast = lastName|length > 0 ? lastName|slice(0, 1) ~ '.' : '' %}
                    <strong>{{ maskedFirst }} {{ maskedLast }}</strong>
                </div>
                <div class="rating">
                    <div class="product_rate" style="width: {{ ((review.rating / 5) * 100)|round }}%;"></div>
                </div>
                <small class="text-muted">{{ review.createdAt|date('d/m/Y') }}</small>
            </div>
            {% if review.comment %}
            <p class="mb-0 mt-2">{{ review.comment }}</p>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# --- Formulaire d'avis --- #}
    {% if app.user %}
        <div class="review-form-wrapper border rounded p-4 bg-light">
            <h5 class="mb-3">
                {% if userReview %}
                    Modifier votre avis
                {% else %}
                    Laisser un avis
                {% endif %}
            </h5>

            {% if userReview and userReview.status.value == 'pending' %}
            <div class="alert alert-info mb-3">
                Votre avis est en cours de modération et sera affiché prochainement.
            </div>
            {% endif %}

            {{ form_start(reviewForm, { attr: { novalidate: 'novalidate' } }) }}

            <div class="mb-3">
                {{ form_label(reviewForm.rating) }}
                <div class="star-rating-input d-flex align-items-center gap-2">
                    {% for i in 1..5 %}
                    <label class="star-label" for="star_{{ i }}">
                        <input
                            type="radio"
                            name="{{ reviewForm.rating.vars.full_name }}"
                            id="star_{{ i }}"
                            value="{{ i }}"
                            class="star-radio visually-hidden"
                            {% if reviewForm.rating.vars.value == i %}checked{% endif %}
                        >
                        <span class="star-icon fs-4" data-value="{{ i }}" style="cursor:pointer; color: {{ reviewForm.rating.vars.value is not null and reviewForm.rating.vars.value >= i ? '#e37e03' : '#ccc' }};">★</span>
                    </label>
                    {% endfor %}
                    <small class="text-muted ms-1">(<span id="ratingDisplay">{{ reviewForm.rating.vars.value ?? '?' }}</span>/5)</small>
                </div>
                {{ form_errors(reviewForm.rating) }}
                {# Marquer le champ comme rendu pour éviter le re-affichage par form_end() #}
                {% do reviewForm.rating.setRendered() %}
            </div>

            <div class="mb-3">
                {{ form_label(reviewForm.comment) }}
                {{ form_widget(reviewForm.comment, { attr: { class: 'form-control' } }) }}
                {{ form_errors(reviewForm.comment) }}
            </div>

            <button type="submit" class="btn btn-fill-out">
                {% if userReview %}Mettre à jour mon avis{% else %}Soumettre mon avis{% endif %}
            </button>

            {{ form_end(reviewForm) }}
        </div>

        <script>
        (function () {
            var radios = document.querySelectorAll('.star-radio');
            var icons  = document.querySelectorAll('.star-icon');
            var display = document.getElementById('ratingDisplay');

            function paintStars(value) {
                icons.forEach(function (icon) {
                    icon.style.color = parseInt(icon.dataset.value, 10) <= value ? '#e37e03' : '#ccc';
                });
                if (display) display.textContent = value;
            }

            radios.forEach(function (radio) {
                radio.addEventListener('change', function () {
                    paintStars(parseInt(this.value, 10));
                });
            });

            icons.forEach(function (icon) {
                icon.addEventListener('click', function () {
                    var val = parseInt(this.dataset.value, 10);
                    radios.forEach(function (r) {
                        r.checked = parseInt(r.value, 10) === val;
                    });
                    paintStars(val);
                });
            });
        })();
        </script>

    {% else %}
        <div class="alert alert-light border mt-3">
            <a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un avis sur ce produit.
        </div>
    {% endif %}

</div>
