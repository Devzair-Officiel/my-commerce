<div class="nide-reviews">

    {# ── Note moyenne ── #}
    {% if averageRating is not null %}
    <div class="nide-reviews__summary">
        <div class="nide-reviews__score">
            <span class="nide-reviews__score-number">{{ averageRating|number_format(1, ',') }}</span>
            <span class="nide-reviews__score-max">/5</span>
        </div>
        <div class="nide-reviews__summary-right">
            <div class="nide-reviews__stars-wrap">
                {% for i in 1..5 %}
                    <span class="nide-reviews__star {% if averageRating >= i %}nide-reviews__star--full{% elseif averageRating >= i - 0.5 %}nide-reviews__star--half{% endif %}">★</span>
                {% endfor %}
            </div>
            <span class="nide-reviews__count">{{ reviews|length }} avis{{ reviews|length > 1 ? 's' : '' }}</span>
        </div>
    </div>
    {% else %}
    <p class="nide-reviews__empty">Aucun avis pour ce produit. Soyez le premier !</p>
    {% endif %}

    {# ── Liste des avis ── #}
    {% if reviews|length > 0 %}
    <div class="nide-reviews__list">
        {% for review in reviews %}
        <div class="nide-review">
            <div class="nide-review__header">
                <div class="nide-review__avatar">
                    {% set firstName = review.user.firstName ?? '' %}
                    {{ firstName|length > 0 ? firstName|slice(0, 1)|upper : '?' }}
                </div>
                <div class="nide-review__meta">
                    <span class="nide-review__author">
                        {% set firstName = review.user.firstName ?? '' %}
                        {% set lastName  = review.user.lastName ?? '' %}
                        {% if firstName|length > 3 %}
                            {{ firstName|slice(0, 3) }}*
                        {% elseif firstName|length > 0 %}
                            {{ firstName|slice(0, 1) }}*
                        {% else %}
                            Anonyme
                        {% endif %}
                        {{ lastName|length > 0 ? lastName|slice(0, 1) ~ '.' : '' }}
                    </span>
                    <span class="nide-review__date">{{ review.createdAt|date('d/m/Y', 'Europe/Paris') }}</span>
                </div>
                <div class="nide-review__stars">
                    {% for i in 1..5 %}
                        <span class="nide-reviews__star {% if review.rating >= i %}nide-reviews__star--full{% endif %}">★</span>
                    {% endfor %}
                </div>
            </div>
            {% if review.comment %}
            <p class="nide-review__comment">{{ review.comment }}</p>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# ── Formulaire ── #}
    {% if app.user %}
        <div class="nide-review-form">
            <h3 class="nide-review-form__title">
                {% if userReview %}Modifier votre avis{% else %}Laisser un avis{% endif %}
            </h3>

            {% if userReview and userReview.status.value == 'pending' %}
            <div class="nide-review-form__notice">
                <svg class="icon" aria-hidden="true"><use href="#icon-info"></use></svg>
                Votre avis est en cours de modération et sera affiché prochainement.
            </div>
            {% endif %}

            {{ form_start(reviewForm, { attr: { novalidate: 'novalidate', class: 'nide-review-form__form' } }) }}

            <div class="nide-review-form__field">
                {{ form_label(reviewForm.rating, null, { label_attr: { class: 'nide-review-form__label' } }) }}
                <div class="nide-star-input">
                    {% for i in 1..5 %}
                    <label class="nide-star-input__label" for="star_{{ i }}">
                        <input
                            type="radio"
                            name="{{ reviewForm.rating.vars.full_name }}"
                            id="star_{{ i }}"
                            value="{{ i }}"
                            class="star-radio visually-hidden"
                            {% if reviewForm.rating.vars.value == i %}checked{% endif %}
                        >
                        <span class="nide-star-input__icon" data-value="{{ i }}">★</span>
                    </label>
                    {% endfor %}
                    <small class="nide-star-input__display">(<span id="ratingDisplay">{{ reviewForm.rating.vars.value ?? '?' }}</span>/5)</small>
                </div>
                {{ form_errors(reviewForm.rating) }}
                {% do reviewForm.rating.setRendered() %}
            </div>

            <div class="nide-review-form__field">
                {{ form_label(reviewForm.comment, null, { label_attr: { class: 'nide-review-form__label' } }) }}
                {{ form_widget(reviewForm.comment, { attr: { class: 'form-control nide-review-form__textarea' } }) }}
                {{ form_errors(reviewForm.comment) }}
            </div>

            <button type="submit" class="btn btn-fill-out nide-review-form__submit">
                {% if userReview %}Mettre à jour mon avis{% else %}Soumettre mon avis{% endif %}
            </button>

            {{ form_end(reviewForm) }}
        </div>

        <script>
        (function () {
            var radios  = document.querySelectorAll('.star-radio');
            var icons   = document.querySelectorAll('.nide-star-input__icon');
            var display = document.getElementById('ratingDisplay');

            function paintStars(value) {
                icons.forEach(function (icon) {
                    var active = parseInt(icon.dataset.value, 10) <= value;
                    icon.classList.toggle('nide-star-input__icon--active', active);
                });
                if (display) display.textContent = value;
            }

            // Peindre l'état initial
            var checked = document.querySelector('.star-radio:checked');
            if (checked) paintStars(parseInt(checked.value, 10));

            radios.forEach(function (radio) {
                radio.addEventListener('change', function () { paintStars(parseInt(this.value, 10)); });
            });

            icons.forEach(function (icon) {
                icon.addEventListener('mouseover', function () {
                    icons.forEach(function (ic) {
                        ic.classList.toggle('nide-star-input__icon--hover', parseInt(ic.dataset.value, 10) <= parseInt(icon.dataset.value, 10));
                    });
                });
                icon.addEventListener('mouseout', function () {
                    icons.forEach(function (ic) { ic.classList.remove('nide-star-input__icon--hover'); });
                });
                icon.addEventListener('click', function () {
                    var val = parseInt(this.dataset.value, 10);
                    radios.forEach(function (r) { r.checked = parseInt(r.value, 10) === val; });
                    paintStars(val);
                });
            });
        })();
        </script>

    {% else %}
        <div class="nide-review-form__login">
            <svg class="icon" aria-hidden="true"><use href="#icon-user"></use></svg>
            <a href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un avis sur ce produit.
        </div>
    {% endif %}

</div>
