<div class="col-lg-3 col-md-4 col-6">
	<div class="product">
		<div class="product_img">
			<a href="/produits/{{product.slug}}">
				<img
					alt="{{product.medias[0].alt ?: product.title}}"
					src="/assets/images/products/{{product.medias[0].thumbnailFilename}}"
					width="600" height="600"
					loading="lazy"
					decoding="async"
				>
			</a>
			<div class="product_action_box">
				<ul class="list_none pr_action_btn">
					{% if product.stock != 0 %}
						<li>
							<a href="/cart/add/{{product.id}}/1" data-product-id="{{ product.id }}" class="add-to-cart" title="Ajouter au panier" aria-label="Ajouter {{ product.title }} au panier">
								<svg class="icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
							</a>
						</li>
					{% endif %}
					<li>
						<a href="/compare/add/{{product.id}}" class="add-to-compare" title="Ajouter au comparatif" aria-label="Ajouter {{ product.title }} au comparatif">
							<svg class="icon" aria-hidden="true"><use href="#icon-shuffle"></use></svg>
						</a>
					</li>
					<li>
						<a href="/wishlist/add/{{ product.id }}" class="add-to-wishlist" title="Ajouter a la liste des souhaits" aria-label="Ajouter {{ product.title }} à la liste de souhaits">
							<svg class="icon" aria-hidden="true"><use href="#icon-heart"></use></svg>
						</a>
					</li>
				</ul>
			</div>
		</div>
		<a href="/produits/{{product.slug}}">
			<div class="product_info">
				<h6 class="product_title">
					{{product.title}}
				</h6>
				<div class="product_price">
					{% if product.isOnSale %}
						<span class="price">{{ (product.soldePrice / 100)|number_format(2, ',', ' ') }}€</span>
						<del>
							{{ (product.regularPrice / 100)|number_format(2, ',', ' ') }}€
						</del>
						<div class="on_sale">
							<span>-{{ product.discountPercentage }}%</span>	
						</div>
					{% else %}
						<span class="price">{{ (product.regularPrice / 100)|number_format(2, ',', ' ') }}
							€</span>
					{% endif %}
				</div>

				{% set rating = product_rating(product.id) %}
				<div class="rating_wrap">
					<div class="rating">
						<div class="product_rate" style="width: {{ rating.count > 0 ? ((rating.average / 5) * 100)|round : 0 }}%;"></div>
					</div>
					<span class="rating_num">
						{% if rating.count > 0 %}
							{{ rating.average|number_format(1, ',') }}/5 ({{ rating.count }})
						{% else %}
							Aucun avis
						{% endif %}
					</span>
				</div>
			</div>
		</a>
	</div>
</div>
