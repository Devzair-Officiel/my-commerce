{% extends 'base.html.twig' %}

{% block title %}NideMiel | Détail commande
{% endblock %}

{% block body %}
	{% include "page_head/index.html.twig" with {'page':'Mon compte', 'url': '/account', 'page_name': 'Détail Commande'} %}

	<div class="main_content">
		<div class="section">
			<div class="container">

				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th>Date d'achat</th>
							<th>Produit</th>
							<th>Prix unitaire</th>
							<th>Quantité</th>
							<th>Total</th>
						</tr>
					</thead>

					<tbody>
						{% for line in order.orderDetails %}
							<tr>
								<td>{{ line.createdAt|date('d/m/Y') }}</td>
								<td>{{ line.productName }}</td>

								<td class="price">
									{{ (line.unitPriceCents / 100) | format_currency(order.currency ?? 'EUR') }}
								</td>

								<td>{{ line.quantity }}</td>

								<td>
									{# Tu as déjà lineTotalCents => c’est le plus fiable #}
									{{ (line.lineTotalCents / 100) | format_currency(order.currency ?? 'EUR') }}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="5" class="text-center">Aucun article dans cette commande.</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>

			</div>
		</div>
	</div>
{% endblock %}

