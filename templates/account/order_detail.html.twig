{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderReference ?? '#' ~ order.id }} | {{ globalSetting.website_name }}{% endblock %}

{% block body %}

	{% include 'page_head/index.html.twig' with {
		page_name: 'Détail commande',
		breadcrumbs: [
			{ label: 'Mon compte', url: path('app_account') },
			{ label: 'Commande ' ~ (order.orderReference ?? '#' ~ order.id) }
		]
	} %}

	<main id="main-content">
		<section class="nide-account">
			<div class="container">
				<div style="max-width: 860px; margin: 0 auto;">

					{# Récapitulatif commande #}
					<div class="nide-account__panel">
						<div class="nide-account__panel-head">
							<h2 class="nide-account__panel-title">
								Commande {{ order.orderReference ?? '#' ~ order.id }}
							</h2>
							<span class="nide-account__order-status">{{ order.paymentStatus.label() }}</span>
						</div>

						<div class="nide-account__table-wrap">
							<table class="nide-account__table">
								<thead>
									<tr>
										<th colspan="2">Produit</th>
										<th>Date</th>
										<th>Prix unitaire</th>
										<th>Qté</th>
										<th class="text-end">Total</th>
									</tr>
								</thead>
								<tbody>
									{% for line in order.orderDetails %}
										<tr>
											<td style="width:60px; padding-right:0">
												{% if line.productImageUrl %}
													<img src="{{ line.productImageUrl }}"
														alt="{{ line.productImageAlt ?? line.productName }}"
														style="width:52px;height:52px;object-fit:cover;border-radius:8px;display:block;">
												{% endif %}
											</td>
											<td>{{ line.productName }}</td>
											<td class="nide-account__table-date">{{ (order.paidAt ?? order.createdAt)|date('d/m/Y', 'Europe/Paris') }}</td>
											<td>{{ (line.unitPriceCents / 100)|format_currency(order.currency ?? 'EUR') }}</td>
											<td>{{ line.quantity }}</td>
											<td class="text-end">{{ (line.lineTotalCents / 100)|format_currency(order.currency ?? 'EUR') }}</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="6" class="text-center nide-account__empty">Aucun article dans cette commande.</td>
										</tr>
									{% endfor %}
								</tbody>
								{% if order.orderDetails|length > 0 %}
								<tfoot class="nide-account__table-foot">
									{% set itemsTotal = order.itemsTotalHtCents + (order.taxAmountCents ?? 0) %}
									<tr>
										<td colspan="5" class="text-end">Sous-total produits</td>
										<td class="text-end fw-semibold">{{ (itemsTotal / 100)|format_currency(order.currency ?? 'EUR') }}</td>
									</tr>
									<tr>
										<td colspan="5" class="text-end">
											Livraison{% if order.carrierNameSnapshot %} <span class="nide-account__table-date">({{ order.carrierNameSnapshot }})</span>{% endif %}
										</td>
										<td class="text-end fw-semibold">
											{% if order.carrierPriceSnapshotCents == 0 %}
												<span style="color:#2a7a3a">Offert</span>
											{% else %}
												{{ (order.carrierPriceSnapshotCents / 100)|format_currency(order.currency ?? 'EUR') }}
											{% endif %}
										</td>
									</tr>
									<tr class="nide-account__table-total">
										<td colspan="5" class="text-end fw-bold">Total TTC</td>
										<td class="text-end fw-bold">{{ (order.orderTotalTtcCents / 100)|format_currency(order.currency ?? 'EUR') }}</td>
									</tr>
								</tfoot>
								{% endif %}
							</table>
						</div>
					</div>

					{# Expéditions #}
					{% set shipments = order.shipments %}
					{% if shipments|length > 0 %}
						{% for shipment in shipments %}
						<div class="nide-account__panel" style="margin-top:1.25rem">
							<div class="nide-account__panel-head">
								<h2 class="nide-account__panel-title">
									<svg class="icon me-2" aria-hidden="true"><use href="#icon-truck"></use></svg>
									Expédition{% if shipment.carrier %} — {{ shipment.carrier.name }}{% endif %}
								</h2>
								{% if shipment.shippedAt %}
									<span class="nide-account__table-date">Expédié le {{ shipment.shippedAt|date('d/m/Y', 'Europe/Paris') }}</span>
								{% endif %}
							</div>

							{% if shipment.trackingNumber and shipment.trackingNumber != 'À renseigner' %}
							<div class="nide-account__tracking-row">
								<div>
									<div class="nide-account__tracking-label">N° de suivi</div>
									<div class="fw-semibold" style="font-family:monospace">{{ shipment.trackingNumber }}</div>
								</div>
								<div class="d-flex gap-2 flex-wrap">
									<a href="{{ path('app_account_order_tracking', { orderId: order.id, shipmentId: shipment.id }) }}" class="btn btn-fill-out btn-sm">
										<svg class="icon me-1" aria-hidden="true"><use href="#icon-location"></use></svg>Suivre mon colis
									</a>
									{% if shipment.trackingUrl %}
									<a href="{{ shipment.trackingUrl }}" target="_blank" rel="noopener" class="btn btn-fill-line btn-sm">
										Voir sur laposte.fr <svg class="icon ms-1" aria-hidden="true"><use href="#icon-external-link"></use></svg>
									</a>
									{% endif %}
								</div>
							</div>
							{% endif %}

							{% set pp = order.pickupPoint %}
							{% if pp %}
							<div class="nide-account__pickup-card">
								<svg class="icon me-2" aria-hidden="true"><use href="#icon-location"></use></svg>
								<div>
									<div class="fw-semibold">{{ pp.name }}</div>
									<div class="nide-account__table-date">{{ pp.address }}, {{ pp.postalCode }} {{ pp.city }}</div>
								</div>
							</div>
							{% elseif order.shippingAddress %}
							<div class="nide-account__table-date mt-2">
								<svg class="icon me-1" aria-hidden="true"><use href="#icon-location"></use></svg>
								{{ order.shippingAddress|nl2br }}
							</div>
							{% endif %}
						</div>
						{% endfor %}

					{% elseif order.fulfillmentStatus.value in ['shipped', 'delivered'] %}
						<div class="alert alert-info mt-3">
							<svg class="icon me-2" aria-hidden="true"><use href="#icon-truck"></use></svg>
							Votre commande a été expédiée. Les informations de suivi seront disponibles prochainement.
						</div>
					{% endif %}

					<div class="mt-3">
						<a href="{{ path('app_account') }}#orders" class="nide-trust__link">
							<svg viewBox="0 0 20 20" fill="none" aria-hidden="true" style="transform:rotate(180deg)"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
							Retour à mon compte
						</a>
					</div>

				</div>
			</div>
		</section>
	</main>

{% endblock %}
