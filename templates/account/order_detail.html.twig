{% extends 'base.html.twig' %}

{% block title %}{{globalSetting.website_name}} | Détail commande
{% endblock %}

{% block body %}

	{% include "page_head/index.html.twig" with {
        page_name: 'Détail Commande',
        breadcrumbs: [
            { label: 'Mon compte', url: path('app_account') },
            { label: 'Détail Commande' }
        ]
    } %}

	<div class="main_content">
		<div class="section">
			<div class="container">

				<table class="table table-striped table-hover">
					<thead>
						<tr>
							<th colspan="2">Produit</th>
							<th>Date d'achat</th>
							<th>Prix unitaire</th>
							<th>Quantité</th>
							<th>Total</th>
						</tr>
					</thead>

					<tbody>
						{% for line in order.orderDetails %}
							<tr>
								<td style="width:64px">
									{% if line.productImageUrl %}
										<img src="{{ line.productImageUrl }}"
											 alt="{{ line.productImageAlt ?? line.productName }}"
											 style="width:56px;height:56px;object-fit:cover;border-radius:6px;">
									{% endif %}
								</td>
								<td>{{ line.productName }}</td>
								<td>{{ (order.paidAt ?? order.createdAt)|date('d/m/Y', 'Europe/Paris') }}</td>

								<td class="price">
									{{ (line.unitPriceCents / 100) | format_currency(order.currency ?? 'EUR') }}
								</td>

								<td>{{ line.quantity }}</td>

								<td>
									{# Tu as déjà lineTotalCents => c’est le plus fiable #}
									{{ (line.lineTotalCents / 100) | format_currency(order.currency ?? 'EUR') }}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="6" class="text-center">Aucun article dans cette commande.</td>
							</tr>
						{% endfor %}
					</tbody>

					{% if order.orderDetails|length > 0 %}
					<tfoot>
						{% set itemsTotal = order.itemsTotalHtCents + (order.taxAmountCents ?? 0) %}
						<tr>
							<td colspan="5" class="text-end text-muted">Sous-total produits</td>
							<td class="fw-semibold">{{ (itemsTotal / 100)|format_currency(order.currency ?? 'EUR') }}</td>
						</tr>
						<tr>
							<td colspan="5" class="text-end text-muted">
								Livraison
								{% if order.carrierNameSnapshot %}
									<span class="small">({{ order.carrierNameSnapshot }})</span>
								{% endif %}
							</td>
							<td class="fw-semibold">
								{% if order.carrierPriceSnapshotCents == 0 %}
									<span class="text-success">Offert</span>
								{% else %}
									{{ (order.carrierPriceSnapshotCents / 100)|format_currency(order.currency ?? 'EUR') }}
								{% endif %}
							</td>
						</tr>
						<tr class="table-dark">
							<td colspan="5" class="text-end fw-bold">Total</td>
							<td class="fw-bold">{{ (order.orderTotalTtcCents / 100)|format_currency(order.currency ?? 'EUR') }}</td>
						</tr>
					</tfoot>
					{% endif %}
				</table>

				{# ── Suivi d'expédition ─────────────────────────────────── #}
				{% set shipments = order.shipments %}
				{% if shipments|length > 0 %}
					{% for shipment in shipments %}
					<div class="card mt-4">
						<div class="card-header d-flex justify-content-between align-items-center">
							<span class="fw-semibold">
								<svg class="icon me-2" aria-hidden="true"><use href="#icon-truck"></use></svg>Expédition
								{% if shipment.carrier %}— {{ shipment.carrier.name }}{% endif %}
							</span>
							{% if shipment.shippedAt %}
								<small class="text-muted">Expédié le {{ shipment.shippedAt|date('d/m/Y', 'Europe/Paris') }}</small>
							{% endif %}
						</div>
						<div class="card-body">

							{% if shipment.trackingNumber and shipment.trackingNumber != 'À renseigner' %}
							<div class="d-flex align-items-center gap-3 mb-3">
								<div>
									<div class="text-muted small">N° de suivi</div>
									<div class="fw-semibold">{{ shipment.trackingNumber }}</div>
								</div>
								<a href="{{ path('app_account_order_tracking', { orderId: order.id, shipmentId: shipment.id }) }}"
							   class="btn btn-sm btn-primary">
								<svg class="icon me-1" aria-hidden="true"><use href="#icon-location"></use></svg> Suivre mon colis
							</a>
							{% if shipment.trackingUrl %}
							<a href="{{ shipment.trackingUrl }}" target="_blank" rel="noopener"
							   class="btn btn-sm btn-outline-secondary">
								laposte.fr <svg class="icon ms-1" aria-hidden="true"><use href="#icon-external-link"></use></svg>
							</a>
							{% endif %}
							</div>
							{% endif %}

							{% set pp = order.pickupPoint %}
							{% if pp %}
							<div class="border rounded p-3 bg-light">
								<div class="fw-semibold mb-1"><svg class="icon me-2 text-primary" aria-hidden="true"><use href="#icon-location"></use></svg>Point relais</div>
								<div>{{ pp.name }}</div>
								<div class="text-muted small">{{ pp.address }}, {{ pp.postalCode }} {{ pp.city }}</div>
							</div>
							{% elseif order.shippingAddress %}
							<div class="text-muted small">
								<svg class="icon me-1" aria-hidden="true"><use href="#icon-location"></use></svg>
								{{ order.shippingAddress|nl2br }}
							</div>
							{% endif %}

						</div>
					</div>
					{% endfor %}
				{% elseif order.fulfillmentStatus.value in ['shipped', 'delivered'] %}
					<div class="alert alert-info mt-4">
						<svg class="icon me-2" aria-hidden="true"><use href="#icon-truck"></use></svg>
						Votre commande a été expédiée. Les informations de suivi seront disponibles prochainement.
					</div>
				{% endif %}

			</div>
		</div>
	</div>
{% endblock %}

