{% extends 'base.html.twig' %}

{% block title %}Message #{{ contact.id }}{% endblock %}

{% block body %}
<div class="main_content">
  <div class="section">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <h3>Détail du message #{{ contact.id }}</h3>
              <a href="{{ path('app_account') }}#messages" class="btn btn-outline-secondary">
                <i class="ti-arrow-left"></i> Retour aux messages
              </a>
            </div>
            <div class="card-body">
              <div class="row mb-4">
                <div class="col-md-6">
                  <h5><i class="ti-email"></i> Sujet</h5>
                  <p class="fs-5 fw-bold">{{ contact.subject }}</p>
                </div>
                <div class="col-md-6">
                  <h5><i class="ti-calendar"></i> Date</h5>
                  <p>{{ contact.createdAt|date('d/m/Y à H:i') }}</p>
                  {% if contact.updatedAt and contact.updatedAt != contact.createdAt %}
                    <p class="text-muted small">Mis à jour le {{ contact.updatedAt|date('d/m/Y à H:i') }}</p>
                  {% endif %}
                </div>
              </div>
              <div class="row mb-4">
                <div class="col-md-6">
                  <h5><i class="ti-user"></i> Email</h5>
                  <p>{{ contact.email }}</p>
                </div>
                <div class="col-md-6">
                  {% if contact.phone %}
                    <h5><i class="ti-mobile"></i> Téléphone</h5>
                    <p>{{ contact.phone }}</p>
                  {% endif %}
                </div>
              </div>
              <hr>
              <h5><i class="ti-message-2"></i> Contenu du message</h5>
              <div class="message-content p-3 border rounded bg-light">
                {{ contact.content|nl2br }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
