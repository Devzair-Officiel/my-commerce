<div class="tab-pane fade" id="password" role="tabpanel" aria-labelledby="account-detail-tab">
	<div class="card">
		<div class="card-header">
			<h3>Changer de mot de passe</h3>
		</div>
		{% for message in app.flashes('error') %}
			<div class="alert alert-danger">{{ message }}</div>
		{% endfor %}

		{% for message in app.flashes('success') %}
			<div class="alert alert-success">{{ message }}</div>
		{% endfor %}

		<div class="card-body ">
			{{ form_start(passwordForm) }}
			{{ form_errors(passwordForm) }}
			<div class="input-group mb-3" id="first_password">
				{{ form_widget(passwordForm.currentPassword) }}
				<div class="btn" style="right: 80px; z-index: 5" type="button" onclick="togglePasswordVisibility('first_password', this)">
					<i class="far fa-eye"></i>
				</div>
			</div>
			<div class="input-group mb-3" id="first_password">
				{{ form_widget(passwordForm.plainPassword.first) }}
				<div class="btn" style="right: 80px; z-index: 5" type="button" onclick="togglePasswordVisibility('first_password', this)">
					<i class="far fa-eye"></i>
				</div>
			</div>

			<div class="input-group mb-3" id="second_password">
				{{ form_widget(passwordForm.plainPassword.second) }}
				<button class="btn" style="right: 80px; z-index: 5" type="button" onclick="togglePasswordVisibility('second_password', this)">
					<i class="far fa-eye"></i>
				</button>
			</div>

			<div class="form-group mb-3">
				<button type="submit" name="register" class="btn btn-fill-out btn-block">Modifier</button>
			</div>
			{{ form_end(passwordForm) }}
		</div>
	</div>
</div>
