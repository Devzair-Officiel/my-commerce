{% extends 'base.html.twig' %}

{% block title %}{{globalSetting.website_name}} | Mon compte
{% endblock %}

{% block csrf_meta %}
	<meta name="csrf-token-address" content="{{ csrf_token('address_api') }}">
{% endblock %}

{% block body %}

	<div id="account-page" data-address-api="{{ path('api_address_create') }}" data-countries-url="{{ asset('assets/data/countries.json') }}">

		{% include "page_head/index.html.twig" with {'page_name': 'Mon compte'} %}

		<div class="main_content">
			<div class="section">
				<div class="container">
					<div class="row">
						<div class="col-lg-3 col-md-4">
							<div class="dashboard_menu">
								<ul class="nav nav-tabs flex-column" role="tablist">
									<li class="nav-item">
										<a class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" href="#dashboard" role="tab" aria-controls="dashboard" aria-selected="true">
											<i class="ti-layout-grid2"></i>Tableau debord
										</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" id="orders-tab" data-bs-toggle="tab" href="#orders" role="tab" aria-controls="orders" aria-selected="false">
											<i class="ti-shopping-cart-full"></i>Mes commandes</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" id="messages-tab" data-bs-toggle="tab" href="#messages" role="tab" aria-controls="messages" aria-selected="false">
											<i class="ti-email"></i>Mes messages</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" id="address-tab" data-bs-toggle="tab" href="#address" role="tab" aria-controls="address" aria-selected="true">
											<i class="ti-location-pin"></i>Mes Adresses</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" id="account-detail-tab" data-bs-toggle="tab" href="#account-detail" role="tab" aria-controls="account-detail" aria-selected="true">
											<i class="ti-id-badge"></i>Mes informations</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" id="account-detail-tab password-tab" data-bs-toggle="tab" href="#password" role="tab" aria-controls="account-detail" aria-selected="true">
											<i class="ti-lock"></i>
											Mot de passe
										</a>
									</li>
									<li class="nav-item">
										<a class="nav-link" id="logout-tab" href="/logout">
											<i class="ti-shift-right"></i>Deconnexion</a>
									</li>
								</ul>
							</div>
						</div>
						<div class="col-lg-9 col-md-8">
							<div class="tab-content dashboard_content">
								<div class="tab-pane fade active show" id="dashboard" role="tabpanel" aria-labelledby="dashboard-tab">
									<div class="card">
										<div class="card-header">
											<h3>Tableau de bord</h3>
										</div>
										<div class="card-body">
											<p>
												Nous sommes ravis de vous compter parmi nous depuis le
												{{ app.user.createdAt | date('d/m/Y') }}.

												<br>
												Vous pouvez consulter et gérer vos commandes, vos adresses et vos informations
																																																							                              personnelles.
												<br>
												{% if orders | length > 0 %}
													Nous vous remercions pour vos
													{{orders | length}}
													commande passé.
													<br>
												{% endif %}
												Nous ésperons que vous trouverez votre bonheur parmi nos produits.
																																																							                              N'hésitez pas à nous contacter pour toute question ou information complémentaire.
											</p>
										</div>
									</div>
								</div>
								
								<div class="tab-pane fade" id="logout" role="tabpanel" aria-labelledby="logout-tab">
									<div class="card">
										<div class="card-header">
											<h3>Deconnexion</h3>
										</div>
										<div class="card-body">
											<button type="submit" class="btn btn-fill-out py-2" name="submit" value="Submit">Logout</button>
										</div>
									</div>
								</div>
								<div class="tab-pane fade" id="orders" role="tabpanel" aria-labelledby="orders-tab">
									<div class="card">
										<div class="card-header">
											<h3>Commandes</h3>
										</div>
										<div class="card-body">
											<div id="orders-table-container">
												{% include 'account/_orders_table.html.twig' %}
											</div>
										</div>
									</div>
								</div>
								
								<div class="tab-pane fade" id="messages" role="tabpanel" aria-labelledby="messages-tab">
									<div class="card">
										<div class="card-header">
											<h3>Mes messages</h3>
										</div>
										<div class="card-body">
											<div class="table-responsive">
												<table class="table">
													<thead>
														<tr>
															<th>Sujet</th>
															<th>Message</th>
															<th>Date</th>
														</tr>
													</thead>
													<tbody>
														{% for contact in contacts %}
														<tr>
															<td>{{ contact.subject }}</td>
															<td>{{ contact.content|striptags|slice(0, 40) ~ '...' }}</td>
															<td>{{ contact.createdAt|date('d/m/Y H:i') }}</td>
															<td>
																<a href="{{ path('app_account_message_detail', {'id': contact.id}) }}" class="btn btn-fill-out btn-sm">Détail</a>
															</td>
														</tr>
														{% else %}
														<tr>
															<td colspan="4" class="text-center text-muted">Aucun message pour le moment.</td>
														</tr>
														{% endfor %}
													</tbody>
												</table>
											</div>
										</div>
									</div>
								</div>

								<div class="tab-pane fade" id="address" role="tabpanel" aria-labelledby="address-tab">
									<div class="row">
										<div id="address_details" class="col-lg-12 d-block">
											<div class="card">
												<div class="card-header">
													<h3>Adresses</h3>
												</div>
												<div class="card-body">
													<div class="table-responsive address_content">
														<table class="table">
															<thead>
																<tr>
																	<th>Id</th>
																	<th>Adresse</th>
																	<th>Actions</th>
																</tr>
															</thead>
															<tbody id="address-tbody">
																{% for address in addresses %}
																	<tr>
																		<td>{{ address.id }}</td>
																		<td>
																			{{ address.street }}
																			{{ address.codePostal }}
																			{{ address.city }}
																			{{ address.state }}
																		</td>
																		<td>
																			<a href="#" class="btn btn-fill-out btn-sm edit_address" data-id="{{ address.id }}" data-address_type="{{ address.addressType }}" data-client_name="{{ address.clientName }}" data-name="{{ address.name }}" data-street="{{ address.street }}" data-code_postal="{{ address.codePostal }}" data-city="{{ address.city }}" data-state="{{ address.state }}">Modifier</a>
																		</td>
																		<td>
																			<a href="#" class="btn btn-fill-out btn-sm remove_address" data-id="{{ address.id }}">Supprimer</a>
																		</td>
																	</tr>
																{% endfor %}
															</tbody>

														</table>
													</div>
												</div>
											</div>
										</div>
										<div class="action text-center mt-4">
											<a href="#" id="add_new_address" class="btn btn-fill-out">Ajouter une adresse</a>
										</div>

										<div class="col-lg-12 d-none" id="add_form">
											<form action="">
												<div class="row">
													<div class="form-group col-md-12 mb-3">
														<label>Type de l'adresse<span class="required">*</span>
														</label>
														<select name="address_type" id="address_type" class="form-control">
															<option value="facturation">Facturation</option>
															<option value="livraison">Livraison</option>
														</select>
													</div>
													<div class="form-group col-md-12 mb-3">
														<label>Nom de l'adresse<span class="required">*</span>
														</label>
														<input required="" class="form-control" name="name" type="text">
													</div>
													<div class="form-group col-md-12 mb-3">
														<label>Nom du destinataire
															<span class="required">*</span>
														</label>
														<input required="" class="form-control" name="client_name">
													</div>
													<div class="form-group col-md-6 mb-3">
														<label>Rue
															<span class="required">*</span>
														</label>
														<input required="" class="form-control" name="street" type="text">
													</div>
													<div class="form-group col-md-6 mb-3">
														<label>Ville
															<span class="required">*</span>
														</label>
														<input required="" class="form-control" name="city" type="text">
													</div>
													<div class="form-group col-md-6 mb-3">
														<label>Code postal
															<span class="required">*</span>
														</label>
														<input required="" class="form-control" name="code_postal" type="text">
													</div>
													<div class="form-group col-md-6 mb-3">
														<label>Pays
															<span class="required">*</span>
														</label>
														<select class="form-control" name="state" id="state"></select>
													</div>
													<div class="col-md-12">
														<button type="submit" class="btn btn-fill-out" name="submit" value="Submit">Save</button>
													</div>
												</div>
											</form>
										</div>

									</div>
								</div>

								<div class="tab-pane fade" id="account-detail" role="tabpanel" aria-labelledby="account-detail-tab">
									<div class="card">
										<div class="card-header">
											<h3>Informations</h3>
										</div>
										<div class="card-body">
											<div id="messageInfo" class="mb-3"></div>

											{% for message in app.flashes('error') %}
												<div class="alert alert-danger">{{ message }}</div>
											{% endfor %}

											{% for message in app.flashes('success') %}
												<div class="alert alert-success">{{ message }}</div>
											{% endfor %}

											{{ form_start(editForm, {'attr': {'id': 'editUserForm'}}) }}
											{{ form_errors(editForm) }}
											{{ form_row(editForm.email) }}
											{{ form_row(editForm.civility) }}
											{{ form_row(editForm.lastname) }}
											{{ form_row(editForm.firstname) }}
											{{ form_row(editForm.phone) }}
											<div class="form-group mb-3">
												<button type="submit" name="register" class="btn btn-fill-out btn-block">Modifier</button>
											</div>
											{{ form_end(editForm) }}
										</div>
									</div>
								</div>

								<div class="tab-pane fade" id="password" role="tabpanel" aria-labelledby="account-detail-tab">
									<div class="card">
										<div class="card-header">
											<h3>Changer de mot de passe</h3>
										</div>
										<div
											class="card-body ">
											<!-- Zone pour afficher les messages de retour de l'AJAX -->
											<div id="messageBox" class="mb-3"></div>

											<form id="passwordForm">
												<div class="input-group mb-3" id="old_password">
													<input type="password" id="currentPassword" name="currentPassword" class="form-control" placeholder="Mot de passe actuel" required>
													<div class="btn" style="right: 0px; z-index: 5" type="button" onclick="togglePasswordVisibility('old_password', this)">
														<i class="far fa-eye"></i>
													</div>
												</div>
												<div class="input-group mb-3" id="first_password">
													<input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="Nouveau mot de passe" required>
													<div class="btn" style="right: 0px; z-index: 5" type="button" onclick="togglePasswordVisibility('first_password', this)">
														<i class="far fa-eye"></i>
													</div>
												</div>
												<div class="input-group mb-3" id="second_password">
													<input type="password" id="newPasswordConfirm" name="newPasswordConfirm" class="form-control" placeholder="Confirmez le nouveau mot de passe" required>
													<button class="btn" style="right: 0px; z-index: 5" type="button" onclick="togglePasswordVisibility('second_password', this)">
														<i class="far fa-eye"></i>
													</button>
												</div>
												<div class="form-group mb-3">
													<button type="button" onclick="submitPasswordChange()" class="btn btn-fill-out btn-block">Modifier</button>
												</div>
											</form>
										</div>
									</div>
								</div>


							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('assets/js/pages/account/account.js') }}" type="module"></script>
{% endblock %}
