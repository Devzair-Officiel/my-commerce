{# Fragment AJAX pour le tableau des commandes + pagination #}
{% if orders is empty %}
	<p class="nide-account__empty">Aucune commande pour le moment.</p>
{% else %}
	<div class="nide-account__table-wrap">
		<table class="nide-account__table">
			<thead>
				<tr>
					<th>Référence</th>
					<th>Date</th>
					<th>Statut</th>
					<th>Total TTC</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
			{% for order in orders %}
				<tr>
					<td>{{ order.orderReference ?? '#' ~ order.id }}</td>
					<td class="nide-account__table-date">{{ (order.paidAt ?? order.createdAt)|date('d/m/Y', 'Europe/Paris') }}</td>
					<td>{{ order.paymentStatus.label() }}</td>
					<td>{{ (order.orderTotalTtcCents / 100)|format_currency(order.currency) }}</td>
					<td style="white-space:nowrap">
						<a href="/account/order/{{ order.id }}" class="nide-account__table-action">Détail</a>
						{% if order.invoice is not null and order.invoice.isIssued %}
							&nbsp;·&nbsp;
							<a href="{{ path('app_account_invoice_download', {id: order.invoice.id}) }}" class="nide-account__table-action" title="Facture {{ order.invoice.invoiceNumber }}">Facture</a>
						{% endif %}
					</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
	</div>
{% endif %}

{% if ordersPages is defined and ordersPage is defined and ordersPages > 1 %}
	<nav aria-label="Pagination commandes" class="mt-3">
		<ul class="pagination justify-content-center">
			<li class="page-item{% if ordersPage == 1 %} disabled{% endif %}">
				<a class="page-link" href="{{ path('app_account_orders_ajax', {'page': ordersPage - 1}) }}" data-page="{{ ordersPage - 1 }}" tabindex="-1">&laquo;</a>
			</li>
			{% for p in 1..ordersPages %}
				<li class="page-item{% if p == ordersPage %} active{% endif %}">
					<a class="page-link" href="{{ path('app_account_orders_ajax', {'page': p}) }}" data-page="{{ p }}">{{ p }}</a>
				</li>
			{% endfor %}
			<li class="page-item{% if ordersPage == ordersPages %} disabled{% endif %}">
				<a class="page-link" href="{{ path('app_account_orders_ajax', {'page': ordersPage + 1}) }}" data-page="{{ ordersPage + 1 }}">&raquo;</a>
			</li>
		</ul>
	</nav>
{% endif %}
