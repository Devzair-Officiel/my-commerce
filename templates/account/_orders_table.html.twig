{# Fragment AJAX pour le tableau des commandes + pagination #}
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Commande</th>
                <th>Date</th>
                <th>Statut</th>
                <th>Total TTC</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for order in orders %}
            <tr>
                    <td>{{ order.orderReference ?? '#' ~ order.id }}</td>
                    <td>{{ order.createdAt|date('d/m/Y') }}</td>
                    <td>{{ order.paymentStatus.label() }}</td>
                    <td>{{ (order.orderTotalTtcCents / 100)|format_currency(order.currency) }}</td>
                    <td>
                        <a href="/account/order/{{order.id}}" class="btn btn-fill-out btn-sm">Détail</a>
                    </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% if ordersPages is defined and ordersPage is defined and ordersPages > 1 %}
    <nav aria-label="Pagination commandes" class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item{% if ordersPage == 1 %} disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('app_account_orders_ajax', {'page': ordersPage - 1}) }}"
                   data-page="{{ ordersPage - 1 }}"
                   tabindex="-1"
                   aria-disabled="{{ ordersPage == 1 ? 'true' : 'false' }}">
                    &laquo;
                </a>
            </li>
            {% for p in 1..ordersPages %}
                <li class="page-item{% if p == ordersPage %} active{% endif %}">
                    <a class="page-link"
                       href="{{ path('app_account_orders_ajax', {'page': p}) }}"
                       data-page="{{ p }}">
                        {{ p }}
                    </a>
                </li>
            {% endfor %}
            <li class="page-item{% if ordersPage == ordersPages %} disabled{% endif %}">
                <a class="page-link"
                   href="{{ path('app_account_orders_ajax', {'page': ordersPage + 1}) }}"
                   data-page="{{ ordersPage + 1 }}"
                   aria-disabled="{{ ordersPage == ordersPages ? 'true' : 'false' }}">
                    &raquo;
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
