{% extends 'base.html.twig' %}

{% block title %} {{globalSetting.website_name}} | Blog
{% endblock %}

{% block body %}

    {% include 'page_head/index.html.twig' with {
        'page_name': "blog",
        breadcrumbs: [
            {
                label: 'Blog',
            },
        ]
    } %}

	<div class="container my-5">
		<div id="arrival" role="tabpanel" aria-labelledby="arrival-tab" class="tab-pane fade show active">
			<div class="row shop_container">
				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 ">
					{% for blog in blogs %}
						<div class="col">
							<a href="/blog/{{blog.slug}}" class="blog_card">
								<div class="card h-100 blog_card">
									<div class="image-container">
										<img
											src="/assets/images/blogs/{{ blog.medias[0].thumbnailFilename }}"
											class="card-img-top"
											alt="{{ blog.medias[0].alt }}"
											width="600" height="600"
											loading="lazy"
											decoding="async"
										>
									</div>
									<div class="card-body">
										<h3 class="card-title text-center">{{blog.title}}</h3>
										<div class="card-text">
											{{blog.description|normalize_editor_html|raw}}
										</div>
									</div>
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
	</div>

{% endblock %}
