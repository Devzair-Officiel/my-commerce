{% extends 'base.html.twig' %}

{% block title %}FAQ miel : qualité, origine, conservation, cristallisation | {{ globalSetting.website_name }}{% endblock %}

{% block body %}

	{% include 'page_head/index.html.twig' with {
		'page_name': 'Questions fréquentes sur nos miels',
		breadcrumbs: [{ label: 'FAQ' }]
	} %}

	<main id="main-content">
		<section class="nide-faq-page">
			<div class="container">

				<div class="nide-faq-page__intro">
					<span class="nide-faq__kicker">FAQ</span>
					<h1 class="nide-faq-page__title">Questions fréquentes sur nos miels</h1>
					<p class="nide-faq-page__lead">
                        Choisir un miel en ligne soulève souvent les mêmes questions. Comment reconnaître un miel de qualité ? Pourquoi l’origine est-elle importante ? Le miel cristallise-t-il naturellement ? Comment le conserver dans de bonnes conditions ?
                        Cette FAQ a été pensée pour répondre simplement à ces questions, avec une approche claire, sérieuse et utile. Vous y trouverez des repères concrets pour mieux comprendre les différences entre les miels, lire une fiche produit avec plus de recul, et choisir une référence adaptée à vos goûts.
                    </p>
				</div>

				<div class="nide-faq-page__body">

					<div class="nide-faq-page__main">
						{% if faqsBySection is not empty %}
							{% set isFirstItem = true %}
							{% for section, sectionFaqs in faqsBySection %}
								{% set sectionIndex = loop.index %}
								{% set isFirstSection = loop.first %}
								<div class="nide-faq__section" id="faq-section-{{ sectionIndex }}">
									{% if section %}
										<button
											class="nide-faq__section-toggle"
											type="button"
											data-bs-toggle="collapse"
											data-bs-target="#faq-section-body-{{ sectionIndex }}"
											aria-expanded="{{ isFirstSection ? 'true' : 'false' }}"
											aria-controls="faq-section-body-{{ sectionIndex }}"
										>
											<h2 class="nide-faq__section-title">{{ section }}</h2>
											<span class="nide-faq__section-icon" aria-hidden="true">
												<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
											</span>
										</button>
									{% endif %}
									<div id="faq-section-body-{{ sectionIndex }}" class="collapse {% if isFirstSection %}show{% endif %}">
										<div class="nide-faq__list" id="faqAccordion-{{ sectionIndex }}">
											{% for faq in sectionFaqs %}
												<div class="nide-faq__item {% if isFirstItem %}is-open{% endif %}">
													<button
														class="nide-faq__question"
														type="button"
														data-bs-toggle="collapse"
														data-bs-target="#faq-p-{{ faq.id }}"
														aria-expanded="{{ isFirstItem ? 'true' : 'false' }}"
														aria-controls="faq-p-{{ faq.id }}"
														id="faq-p-heading-{{ faq.id }}"
													>
														<span>{{ faq.question }}</span>
														<span class="nide-faq__icon" aria-hidden="true">
															<svg viewBox="0 0 24 24" fill="none"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
														</span>
													</button>
													<div
														id="faq-p-{{ faq.id }}"
														class="accordion-collapse collapse {% if isFirstItem %}show{% endif %}"
														aria-labelledby="faq-p-heading-{{ faq.id }}"
														data-bs-parent="#faqAccordion-{{ sectionIndex }}"
													>
														<div class="nide-faq__answer">
															{{ faq.answer|nl2br }}
														</div>
													</div>
												</div>
												{% set isFirstItem = false %}
											{% endfor %}
										</div>
									</div>
								</div>
							{% endfor %}
						{% else %}
							<p class="nide-faq-page__empty">Aucune question disponible pour le moment.</p>
						{% endif %}

						<p class="nide-faq-page__guide">
							Vous voulez aller plus loin&nbsp;?
							<a href="{{ path('app_guide_sensoriel') }}#degustation">Découvrez notre guide de dégustation</a>
							pour reconnaître les arômes.
						</p>

					</div>

					{% if faqLinks is not empty %}
					<aside class="nide-faq-page__sidebar">
						<div class="nide-faq-sidebar__card">
							<h3 class="nide-faq-sidebar__title">À lire aussi</h3>
							<ul class="nide-faq-sidebar__list">
								{% for link in faqLinks %}
									<li class="nide-faq-sidebar__item">
										<a href="{{ link.url }}" class="nide-faq-sidebar__link">
											<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
											<span>
												<strong>{{ link.label }}</strong>
												{% if link.description %}
													<em>{{ link.description }}</em>
												{% endif %}
											</span>
										</a>
									</li>
								{% endfor %}
							</ul>
						</div>
					</aside>
					{% endif %}

				</div>

				<div class="nide-faq-page__cta">
					<p>Vous ne trouvez pas la réponse à votre question&nbsp;?</p>
					<a href="{{ path('app_contact') }}" class="nide-trust__link">
						Contactez-nous
						<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</div>

				<div class="nide-faq-page__pro-banner">
					<div class="nide-faq-page__pro-banner-inner">
						<div>
							<strong>Vous êtes professionnel&nbsp;?</strong>
							<p>Revendeurs, restaurateurs, épiceries fines — consultez notre FAQ dédiée aux achats en gros et nos conditions professionnelles.</p>
						</div>
						<a href="{{ path('app_grossiste_index') }}#faq-pro" class="btn btn-fill-out">
							<svg class="icon" aria-hidden="true"><use href="#icon-truck"></use></svg>
							Espace grossiste
						</a>
					</div>
				</div>

			</div>
		</section>
	</main>

{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if faqs is not empty %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in faqs %}
    {
      "@type": "Question",
      "name": {{ faq.question|json_encode|raw }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ faq.answer|striptags|json_encode|raw }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
{% endblock %}
