{% extends 'base.html.twig' %}

{% block title %}{{globalSetting.website_name}} | Panier
{% endblock %}

{% block body %}
	{% include "page_head/index.html.twig" with {'page_name': 'Panier'} %}

	<div class="main_content cart_content"
     data-cart='{{ cart|json_encode|e("html_attr") }}'>
		<div class="section">
			<div class="container">
				<div class="row">
					<div class="col-12">
						<div class="table-responsive shop_cart_table">
							<table class="table">
								<thead>
									<tr>
										<th class="product-thumbnail">&nbsp;</th>
										<th class="product-title">Produit</th>
										<th class="product-price">Prix</th>
										<th class="product-quantity">Quantité</th>
										<th class="product-subtotal">Taxe</th>
										<th class="product-subtotal">Total HT</th>
										<th class="product-subtotal">Total TTC</th>
										<th class="product-remove">Supprimer</th>
									</tr>
								</thead>
								<tbody>
									{% for item in cart.items %}
										{% set img = item.product.image[0] ?? null %}
										{% if img %}
											{% set parts = img.filename|split('.') %}
											{% set base = parts|slice(0, parts|length - 1)|join('.') %}
											{% set thumbSrc = '/assets/images/products/' ~ base ~ '-thumb.webp' %}
										{% else %}
											{% set thumbSrc = '' %}
										{% endif %}
									<tr>
										<td class="product-thumbnail">
											<a href="/produits/{{ item.product.slug }}">
												<img width="50" height="50"
													alt="{{ img.alt ?? item.product.title }}"
													src="{{ thumbSrc }}"
													loading="lazy" decoding="async">
											</a>
										</td>
										<td class="product-title"><a>{{ item.product.title }}</a></td>
										<td class="product-price"></td>
										<td class="product-quantity"></td>
										<td class="product-subtotal"></td>
										<td class="product-subtotal"></td>
										<td class="product-subtotal"></td>
										<td class="product-remove"></td>
									</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="medium_divider"></div>
						<div class="divider center_icon">
							<svg class="icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
						</div>
						<div class="medium_divider"></div>
					</div>
				</div>
				<div class="row">
					<div class="col-md-6 offset-md-6">
						<div class="border p-3 p-md-4">
							<div class="heading_s1 mb-3">
								<h6>Total du panier</h6>
							</div>
							<div class="table-responsive">
								<table class="table">
									<table class="table">
										<tbody>
											<tr>
												<td class="cart_total_label">Total HT</td>
												<td class="cart_sub_total_ht_amount"></td>
											</tr>
											<tr>
												<td class="cart_total_label">Taxe</td>
												<td class="cart_sub_total_taxe_amount"></td>
											</tr>
											<tr>
												<td class="cart_total_label">Frais de livraison</td>
												<td class="text-muted fst-italic">Calculés à l'étape suivante</td>
											</tr>
											<tr>
												<td class="cart_total_label">Total TTC</td>
												<td class="cart_total_amount">
													<strong></strong>
												</td>
											</tr>
										</tbody>
									</table>
								</table>
							</div>
							<a class="btn btn-fill-out" href="/checkout">Procéder au paiement</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
{% endblock %}
