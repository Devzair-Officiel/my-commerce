<footer class="nide-footer" role="contentinfo">

	<div class="nide-footer__body">
		<div class="container">
			<div class="nide-footer__grid">

				{# ── Colonne marque ── #}
				<div class="nide-footer__col nide-footer__col--brand">
					<a href="/" class="nide-footer__logo" aria-label="{{ globalSetting.website_name }} — Accueil">
						{% if globalSetting.logo_filename %}
							<img src="/assets/images/setting/{{ globalSetting.logo_filename }}"
								 alt="{{ globalSetting.website_name }}"
								 width="140" height="42" loading="lazy">
						{% else %}
							<span class="nide-footer__logo-text">{{ globalSetting.website_name }}</span>
						{% endif %}
					</a>
					{% if globalSetting.description %}
						<p class="nide-footer__tagline">{{ globalSetting.description }}</p>
					{% endif %}
					<ul class="nide-footer__social">
						{% if globalSetting.facebookLink %}
						<li>
							<a href="{{ globalSetting.facebookLink }}" target="_blank" rel="noopener"
							   aria-label="{{ globalSetting.website_name }} sur Facebook" class="nide-footer__social-link">
								<svg class="icon" aria-hidden="true"><use href="#icon-facebook"></use></svg>
							</a>
						</li>
						{% endif %}
						{% if globalSetting.instaLink %}
						<li>
							<a href="{{ globalSetting.instaLink }}" target="_blank" rel="noopener"
							   aria-label="{{ globalSetting.website_name }} sur Instagram" class="nide-footer__social-link">
								<svg class="icon" aria-hidden="true"><use href="#icon-instagram"></use></svg>
							</a>
						</li>
						{% endif %}
						{% if globalSetting.youtubeLink %}
						<li>
							<a href="{{ globalSetting.youtubeLink }}" target="_blank" rel="noopener"
							   aria-label="{{ globalSetting.website_name }} sur YouTube" class="nide-footer__social-link">
								<svg class="icon" aria-hidden="true"><use href="#icon-youtube"></use></svg>
							</a>
						</li>
						{% endif %}
					</ul>
				</div>

				{# ── Liens utiles ── #}
				<div class="nide-footer__col">
					<h3 class="nide-footer__heading">Liens utiles</h3>
					<ul class="nide-footer__links">
						{% for page in globalFooterPages %}
							<li><a href="/page/{{ page.slug }}">{{ page.title }}</a></li>
						{% endfor %}
						<li><a href="/faq-miel">FAQ</a></li>
					</ul>
				</div>

				{# ── Mon compte ── #}
				<div class="nide-footer__col">
					<h3 class="nide-footer__heading">Mon compte</h3>
					<ul class="nide-footer__links">
						<li><a href="{{ path('app_account') }}">Mon espace</a></li>
						<li><a href="{{ path('app_login') }}">Connexion</a></li>
						<li><a href="{{ path('app_register') }}">Créer un compte</a></li>
						<li><a href="/cart">Mon panier</a></li>
					</ul>
				</div>

				{# ── Contact ── #}
				<div class="nide-footer__col">
					<h3 class="nide-footer__heading">Contact</h3>
					<ul class="nide-footer__contact">
						{% if globalSetting.street %}
						<li>
							<svg class="icon" aria-hidden="true"><use href="#icon-location"></use></svg>
							<span>{{ globalSetting.street }}, {{ globalSetting.code_postal }} {{ globalSetting.city }}</span>
						</li>
						{% endif %}
						{% if globalSetting.email %}
						<li>
							<svg class="icon" aria-hidden="true"><use href="#icon-mail"></use></svg>
							<a href="mailto:{{ globalSetting.email }}">{{ globalSetting.email }}</a>
						</li>
						{% endif %}
						{% if globalSetting.phone %}
						<li>
							<svg class="icon" aria-hidden="true"><use href="#icon-phone"></use></svg>
							<a href="tel:{{ globalSetting.phone|replace({' ': ''}) }}">{{ globalSetting.phone }}</a>
						</li>
						{% endif %}
					</ul>
				</div>

			</div>
		</div>
	</div>

	{# ── Barre basse ── #}
	<div class="nide-footer__bottom">
		<div class="container">
			<div class="nide-footer__bottom-inner">

				<p class="nide-footer__copy">
					{% if globalSetting.copyrightUrl %}
						<a href="{{ globalSetting.copyrightUrl }}" target="_blank" rel="noopener">{{ globalSetting.copyright }}</a>
					{% else %}
						{{ globalSetting.copyright }}
					{% endif %}
				</p>

				<nav class="nide-footer__legal" aria-label="Liens légaux">
					<a href="{{ path('app_page', {slug: 'mentions-legales'}) }}">Mentions légales</a>
					<a href="{{ path('app_page', {slug: 'politique-de-confidentialite'}) }}">Confidentialité</a>
					<a href="{{ path('app_page', {slug: 'conditions-generales-de-vente'}) }}">CGV</a>
					<button type="button" onclick="window.reopenCookieConsent?.()" class="nide-footer__cookie-btn">
						Cookies
					</button>
				</nav>

			</div>
		</div>
	</div>

</footer>
