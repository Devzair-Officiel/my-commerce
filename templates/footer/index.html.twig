<footer class="footer_dark">
	<div class="footer_top">
		<div class="container">
			<div class="row ">
				<div class="col-lg-3 col-md-6 col-sm-12 text-center">
					<div class="widget">
						<div class="footer_logo">
							<a href="#">
								<h2>{{ globalSetting.website_name }}</h2>
							</a>
						</div>
						<p>{{ globalSetting.description }}</p>
					</div>
					<div class="widget">
						<ul class="social_icons social_white">
							<li>
								<a target="_blank" href="{{ globalSetting.facebookLink}}">
									<i class="ion-social-facebook"></i>
								</a>
							</li>
							<li>
								<a target="_blank" href="{{ globalSetting.youtubeLink}}">
									<i class="ion-social-youtube-outline"></i>
								</a>
							</li>
							<li>
								<a target="_blank" href="{{ globalSetting.instaLink}}">
									<i class="ion-social-instagram-outline"></i>
								</a>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-lg-2 col-md-3 col-sm-6 text-center">
					<div class="widget">
						<h6 class="widget_title">Liens Utiles</h6>
						<ul class="widget_links">
							{% for page in globalFooterPages %}
							<li>
								<a href="/page/{{page.slug}}"> {{page.title}} </a>
							</li>
							
						{% endfor %}
						</ul>
					</div>
				</div>
				<div class="col-lg-2 col-md-3 col-sm-6 text-center">
					<div class="widget">
						<h6 class="widget_title">Categories</h6>
						<ul class="widget_links">
							{% for category in globalMegaCategories %}
								<li class="">
									<a href="{{ path('app_category', {categoryName: category.slug}) }}">
										{{category.title}}
									</a>
								</li>
							{% endfor %}
						</ul>
					</div>
				</div>
				<div class="col-lg-2 col-md-6 col-sm-6 text-center">
					<div class="widget">
						<h6 class="widget_title">Mon compte</h6>
						<ul class="widget_links">
							<li>
								<a href="{{ path('app_account') }}">Dashboard</a>
							</li>
							<li>
								<a href="{{ path('app_login') }}">Connexion</a>
							</li>
							<li>
								<a href="{{ path('app_register') }}">Créer un compte</a>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-lg-3 col-md-4 col-sm-6 text-center">
					<div class="widget">
						<h6 class="widget_title">Contact Info</h6>
						<ul class="contact_info contact_info_light">
							<li>
								<i class="ti-location-pin"></i>
								<p>{{ globalSetting.street}} - {{ globalSetting.code_postal}} {{ globalSetting.city}}</p>
							</li>
							<li>
								<i class="ti-email"></i>
								<a href="{{globalSetting.email}}"> {{globalSetting.email}} </a>
							</li>
							<li>
								<i class="ti-mobile"></i>
								<p>+{{ globalSetting.phone}}</p>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="bottom_footer border-top-tran">
		<div class="container">
			<div class="row">
				<div class="col-md-6 d-flex align-items-center gap-3 flex-wrap">
					<a href="">
                        <p class="mb-0 text-center text-md-start">{{globalSetting.copyright}}</p>
                    </a>
					<button onclick="window.reopenCookieConsent?.()" class="btn-cookie-manage">🍪 Gérer mes cookies</button>
				</div>
				<div class="col-md-6">
					<ul class="footer_payment text-center text-lg-end d-flex gap-2 justify-content-end">
						<li>
							<a href="#"><img src="assets/images/visa.png" alt="Paiement par Visa" width="38" height="24" loading="lazy" decoding="async"></a>
						</li>
						<li>
							<a href="#"><img src="assets/images/discover.png" alt="Paiement par Discover" width="38" height="24" loading="lazy" decoding="async"></a>
						</li>
						<li>
							<a href="#"><img src="assets/images/master_card.png" alt="Paiement par Mastercard" width="38" height="24" loading="lazy" decoding="async"></a>
						</li>
						<li>
							<a href="#"><img src="assets/images/paypal.png" alt="Paiement par PayPal" width="38" height="24" loading="lazy" decoding="async"></a>
						</li>
						<li>
							<a href="#"><img src="assets/images/amarican_express.png" alt="Paiement par American Express" width="38" height="24" loading="lazy" decoding="async"></a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</footer>
