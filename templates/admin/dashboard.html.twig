{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard
{% endblock %}

{% block main %}
	<div class="container-fluid">
		<div class="row g-3">
			<div class="col-12 col-md-4">
				<a class="card text-decoration-none" href="{{ urls.products }}">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center">
							<div>
								<div class="text-muted">Produits</div>
								<div class="fs-2 fw-bold">{{ counts.products }}</div>
							</div>
							<i class="fas fa-box fa-2x text-muted"></i>
						</div>
					</div>
				</a>
			</div>

			<div class="col-12 col-md-4">
				<a class="card text-decoration-none" href="{{ urls.users }}">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center">
							<div>
								<div class="text-muted">Utilisateurs</div>
								<div class="fs-2 fw-bold">{{ counts.users }}</div>
							</div>
							<i class="fas fa-users fa-2x text-muted"></i>
						</div>
					</div>
				</a>
			</div>

			<div class="col-12 col-md-4">
				<a class="card text-decoration-none" href="{{ urls.categories }}">
					<div class="card-body">
						<div class="d-flex justify-content-between align-items-center">
							<div>
								<div class="text-muted">Catégories</div>
								<div class="fs-2 fw-bold">{{ counts.categories }}</div>
							</div>
							<i class="fas fa-tags fa-2x text-muted"></i>
						</div>
					</div>
				</a>
			</div>
		</div>

		<div class="row g-3 mt-1">
			<div class="col-12">
				<div class="card">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<div class="text-muted">Paramètres du site</div>
							<div class="fw-semibold">
								{% if setting %}
									{{ setting.websiteName }}
									—
									{{ setting.currency }}
								{% else %}
									Aucun setting trouvé
								{% endif %}
							</div>
							{% if setting %}
								<div class="text-muted small">
									{{ setting.street }},
									{{ setting.codePostal }}
									{{ setting.city }}
								</div>
							{% endif %}
						</div>

						<div class="d-flex gap-2">
							<a class="btn btn-outline-secondary" href="{{ urls.settings_index }}">
								Voir
							</a>

							{% if urls.settings_edit %}
								<a class="btn btn-primary" href="{{ urls.settings_edit }}">
									Modifier
								</a>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

