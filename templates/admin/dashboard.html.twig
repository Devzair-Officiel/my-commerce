{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard
{% endblock %}



{% block main %}
  {# Chart.js (une seule fois) #}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <div class="container-fluid admin-dashboard">

    {# ================= TOP KPIS ================= #}
    <div class="row g-3 mb-3">
      <div class="col-12 col-lg-3">
		<a class="card kpi-card text-decoration-none" href="{{ urls.orders }}">
			<div class="card-body kpi-body">
				<div class="kpi-head">
					<div class="kpi-icon">
						<i class="fas fa-shopping-cart"></i>
					</div>
				</div>

				<div class="kpi-label">Commandes</div>
				<div class="kpi-value">{{ counts.orders }}</div>
				<div class="kpi-sub">Total</div>
			</div>
		</a>
      </div>

		<div class="col-12 col-lg-3">
			<a class="card kpi-card text-decoration-none" href="{{ urls.orders }}">
				<div class="card-body kpi-body">
					<div class="kpi-head">
						<div class="kpi-icon">
						<i class="fas fa-circle-check"></i>
						</div>

						{% if metrics.kpis.paid30Trend is defined and metrics.kpis.paid30Trend is not null %}
						<span class="kpi-chip {{ metrics.kpis.paid30Trend >= 0 ? 'kpi-chip-up' : 'kpi-chip-down' }}">
							{{ metrics.kpis.paid30Trend >= 0 ? '↑' : '↓' }}
							{{ (metrics.kpis.paid30Trend)|number_format(1, ',', ' ') }}%
						</span>
						{% endif %}
					</div>

					<div class="kpi-label">Payées</div>
					<div class="kpi-value">{{ metrics.kpis.paid30 }}</div>
					<div class="kpi-sub">sur 30 jours</div>
				</div>
			</a>
		</div>


		<div class="col-12 col-lg-3">
			<a class="card kpi-card text-decoration-none" href="{{ urls.orders }}">
				<div class="card-body kpi-body">
					<div class="kpi-head">
						<div class="kpi-icon">
							<i class="fas fa-euro-sign"></i>
						</div>

						{% set trend = metrics.kpis.revenue30Trend ?? null %}

						{% if trend is same as(null) %}
							<span class="kpi-chip">—</span>
						{% else %}
							<span class="kpi-chip {{ trend >= 0 ? 'kpi-chip-up' : 'kpi-chip-down' }}">
								{{ trend >= 0 ? '↑' : '↓' }}
								{{ trend|abs|number_format(1, ',', ' ') }}%
							</span>
						{% endif %}
					</div>

					<div class="kpi-label">CA payé</div>
					<div class="kpi-value">
						{{ (metrics.kpis.revenue30Cents / 100)|number_format(2, ',', ' ') }}
						€
					</div>
					<div class="kpi-sub">sur 30 jours</div>
				</div>
			</a>
		</div>

		<div class="col-12 col-lg-3">
			<div class="card kpi-card kpi-card-static">
				<div class="card-body kpi-body">
					<div class="kpi-head">
						<div class="kpi-icon">
							<i class="fas fa-basket-shopping"></i>
						</div>

						{% if metrics.kpis.avgBasket30Trend is defined and metrics.kpis.avgBasket30Trend is not null %}
							<span class="kpi-chip {{ metrics.kpis.avgBasket30Trend >= 0 ? 'kpi-chip-up' : 'kpi-chip-down' }}">
								{{ metrics.kpis.avgBasket30Trend >= 0 ? '↑' : '↓' }}
								{{ (metrics.kpis.avgBasket30Trend)|number_format(1, ',', ' ') }}%
							</span>
						{% endif %}
					</div>

					<div class="kpi-label">Panier moyen</div>
					<div class="kpi-value">
						{{ (metrics.kpis.avgBasket30Cents / 100)|number_format(2, ',', ' ') }}
						€
					</div>
					<div class="kpi-sub">sur 30 jours</div>
				</div>
			</div>
		</div>

    </div>

    {# ================= STATS (1 grosse card) ================= #}
    <div class="row g-3 mb-3">
      <div class="col-12">
        <div class="card panel-card">
          <div class="card-body p-3">
            <div class="panel-title mb-3">
              <div class="d-flex align-items-center gap-2">
                <i class="fas fa-chart-line"></i>
                <span>Statistiques (14 jours)</span>
              </div>

              {# (optionnel) petit rappel #}
              <span class="text-muted small">
                CA & commandes payées
              </span>
            </div>

            <div class="row g-3">
              <div class="col-12 col-xl-7">
                <div class="card h-100">
                  <div class="card-body p-3">
                    <div class="panel-title">
                      <span>CA payé</span>
                      <i class="fas fa-chart-line"></i>
                    </div>
                    <canvas id="revenueChart" height="140"></canvas>
                  </div>
                </div>
              </div>

              <div class="col-12 col-xl-5">
                <div class="card h-100">
                  <div class="card-body p-3">
                    <div class="panel-title">
                      <span>Commandes payées</span>
                      <i class="fas fa-chart-column"></i>
                    </div>
                    <canvas id="ordersChart" height="140"></canvas>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    {# ================= ALERTS + CATALOGUE + SETTINGS + CONTACTS ================= #}
    <div class="row g-3 mb-3">
		<div class="col-12 col-lg-3">
			<div class="card panel-card h-100">
				<div class="card-body p-3">
					<div class="panel-title">
						<span>À surveiller</span>
						<i class="fas fa-triangle-exclamation"></i>
					</div>

					<div class="watchlist">
						<a class="watch-row" href="{{ urls.orders }}">
							<span class="badge badge-warning">Pending</span>
							<span class="watch-label">Paiements en attente</span>
							<span class="watch-value">{{ metrics.kpis.pendingPayments }}</span>
						</a>

						<a class="watch-row" href="{{ urls.orders }}">
							<span class="badge badge-danger">Failed</span>
							<span class="watch-label">Paiements échoués</span>
							<span class="watch-value">{{ metrics.kpis.failedPayments }}</span>
						</a>

						<a class="watch-row" href="{{ urls.orders }}">
							<span class="badge badge-secondary">Refund</span>
							<span class="watch-label">Remboursements</span>
							<span class="watch-value">{{ metrics.kpis.refundedPayments }}</span>
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="col-12 col-lg-4">
			<div class="card panel-card h-100">
				<div class="card-body p-3">
					<div class="panel-title">
						<span>Messages importants</span>
						<i class="fas fa-envelope"></i>
					</div>

					<div class="watchlist">
						{% for contact in metrics.recentImportantContacts %}
						<a class="watch-row" href="{{ urls.contacts }}/{{contact.id}}">
							<span class="badge badge-warning">Urgent</span>
							<span class="watch-label">{{ contact.email }} - {{ contact.subject }}</span><br>
							<small class="text-muted">{{ contact.createdAt }}</small>
						</a>
						{% else %}
							<div class="text-muted p-3">Aucun message urgent.</div>
						{% endfor %}
					</div>

					{% if metrics.recentImportantContacts|length > 0 %}
					<div class="panel-footer mt-3 d-flex justify-content-end">
						<a class="btn btn-outline-secondary btn-sm" href="{{ urls.contacts }}">Voir tous les messages</a>
					</div>
					{% endif %}
				</div>
			</div>
		</div>

		<div class="col-12 col-lg-2">
			<a class="card kpi-card h-100 text-decoration-none" href="{{ urls.users }}">
				<div class="card-body kpi-body">
					<div class="kpi-head">
						<div class="kpi-icon">
							<i class="fas fa-users"></i>
						</div>

						{# Chip: inscrits ce mois #}
						{% if metrics.kpis.usersThisMonth is defined and metrics.kpis.usersThisMonth is not null %}
							<span class="kpi-chip">
								+{{ metrics.kpis.usersThisMonth }}
							</span>
						{% else %}
							<span class="kpi-chip">—</span>
						{% endif %}
					</div>

					<div class="kpi-label">Utilisateurs</div>
					<div class="kpi-value">{{ counts.users }}</div>
					<div class="kpi-sub">Total</div>
				</div>
			</a>
		</div>

      <div class="col-12 col-lg-3">
		<div class="card panel-card h-100">
			<div class="card-body p-3">
				<div class="panel-title">
					<span>Paramètres du site</span>
					<i class="fas fa-gear"></i>
				</div>

				{% if setting %}
					<div class="settings-header">
						<div class="settings-main">
							<div class="settings-name">{{ setting.websiteName }}</div>
							<div class="settings-meta">
								<span class="settings-pill">
									<i class="fas fa-coins"></i>
									{{ setting.currency }}
								</span>

								{% if setting.taxeRate is not null %}
									<span class="settings-pill">
										<i class="fas fa-receipt"></i>
										TVA
										{{ setting.taxeRate }}%
									</span>
								{% endif %}

								{% if setting.freeShippingThresholdCents is not null %}
									<span class="settings-pill">
										<i class="fas fa-truck-fast"></i>
										Livraison offerte dès
										{{ (setting.freeShippingThresholdCents / 100)|number_format(2, ',', ' ') }}
										€
									</span>
								{% endif %}
							</div>
						</div>

						{% if setting.logoMedia and setting.logoMedia.filename %}
							<div class="settings-logo img-fluid">
								<img src="/assets/images/setting/{{ setting.logoMedia.filename }}" alt="Logo {{ setting.websiteName }}">
							</div>
						{% endif %}
					</div>

					<div class="settings-grid">
						<div class="settings-item">
							<div class="settings-item-label">
								<i class="fas fa-location-dot"></i>
								Adresse</div>
							<div class="settings-item-value">
								{{ setting.street }},
								{{ setting.codePostal }}
								{{ setting.city }}
								{% if setting.state %}
									<span class="text-muted">
										—
										{{ setting.state }}</span>
								{% endif %}
							</div>
						</div>

						<div class="settings-item">
							<div class="settings-item-label">
								<i class="fas fa-address-book"></i>
								Contact</div>
							<div class="settings-item-value">
								{% if setting.email %}
									{{ setting.email }}
								{% else %}
									<span class="text-muted">—</span>
								{% endif %}
								{% if setting.phone %}
									<span class="text-muted">
										•
									</span>
									{{ setting.phone }}
								{% endif %}
							</div>
						</div>
					</div>

					<div class="settings-social">
						{% if setting.facebookLink %}
							<span class="social-pill">
								<i class="fab fa-facebook-f"></i>
							</span>
						{% endif %}
						{% if setting.instaLink %}
							<span class="social-pill">
								<i class="fab fa-instagram"></i>
							</span>
						{% endif %}
						{% if setting.youtubeLink %}
							<span class="social-pill">
								<i class="fab fa-youtube"></i>
							</span>
						{% endif %}
					</div>
				{% else %}
					<div class="text-muted">Aucun réglage trouvé.</div>
				{% endif %}

				<div class="panel-actions">
					<a class="btn btn-outline-secondary" href="{{ urls.settings_index }}">Voir</a>
					{% if urls.settings_edit %}
						<a class="btn btn-primary" href="{{ urls.settings_edit }}">Modifier</a>
					{% endif %}
				</div>
			</div>
		</div>
      </div>
    </div>

    {# ================= TABLE + STOCK ================= #}
    <div class="row g-3">
      <div class="col-12 col-xl-8">
        <div class="card panel-card">
          <div class="card-body p-3">
            <div class="panel-title">
              <span>Dernières commandes</span>
              <i class="fas fa-clock"></i>
            </div>

            <div class="table-responsive">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Client</th>
                    <th>Total</th>
                    <th>Paiement</th>
                    <th>Livraison</th>
                    <th>Date</th>
                  </tr>
                </thead>
                <tbody>
                  {% for o in metrics.recentOrders %}
                    <tr>
                      <td class="fw-semibold">#{{ o.id }}</td>
                      <td>{{ o.email ?? '—' }}</td>
                      <td class="fw-semibold">
                        {{ (o.totalCents / 100)|number_format(2, ',', ' ') }} {{ o.currency ?? 'EUR' }}
                      </td>
                      <td>
                        <span class="badge badge-status-{{ o.paymentStatus|lower }}">{{ o.paymentStatus }}</span>
                      </td>
                      <td>
                        <span class="badge badge-fulfill-{{ o.fulfillmentStatus|lower }}">{{ o.fulfillmentStatus }}</span>
                      </td>
                      <td class="text-muted">
                        {% if o.paidAt %}
                          {{ o.paidAt|date('d/m/Y H:i', 'Europe/Paris') }}
                        {% else %}
                          —
                        {% endif %}
                      </td>
                    </tr>
                  {% else %}
                    <tr><td colspan="6" class="text-muted">Aucune commande.</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

            <div class="panel-footer mt-3 d-flex justify-content-end">
              <a class="btn btn-outline-secondary btn-sm" href="{{ urls.orders }}">Voir toutes les commandes</a>
            </div>
          </div>
        </div>
      </div>

      <div class="col-12 col-xl-4">
		<div class="card panel-card">
			<div class="card-body p-3">
				<div class="panel-title">
					<span>Stock bas</span>
					<i class="fas fa-warehouse"></i>
				</div>

				{% if metrics.lowStock is not empty %}
					<div class="stock-list">
						{% for p in metrics.lowStock %}
							<div class="stock-row">
								<div class="stock-main">
									<div class="stock-title">{{ p.title }}</div>
									<div class="stock-meta">ID #{{ p.id }}</div>
								</div>

								<div class="stock-badge {{ p.stock == 0 ? 'is-out' : 'is-low' }}">
									<span class="stock-badge-label">Stock</span>
									<span class="stock-badge-value">{{ p.stock }}</span>
								</div>
							</div>
						{% endfor %}
					</div>
				{% else %}
					<div class="text-muted">Aucun produit en stock bas.</div>
				{% endif %}

				<div class="panel-footer stock-footer">
					<a class="btn btn-outline-secondary btn-sm" href="{{ urls.products }}">Gérer le stock</a>
				</div>
			</div>
		</div>


      </div>
    </div>

  </div>

  {# Data JSON #}
  <script>
    window.__DASHBOARD__ = {
      labels: {{ metrics.charts.labels|json_encode|raw }},
      paidCount: {{ metrics.charts.paidCount|json_encode|raw }},
      paidRevenueCents: {{ metrics.charts.paidRevenueCents|json_encode|raw }},
    };
  </script>

  {# Charts init #}
  <script>
    (function () {
      const data = window.__DASHBOARD__;
      if (!data) return;

      const axisColor = "rgba(217,221,232,.55)";
      const gridColor = "rgba(255,255,255,.06)";

      const labels = data.labels.map(d => {
        const parts = d.split('-');
        return parts.length === 3 ? (parts[2] + '/' + parts[1]) : d;
      });

      const revenueEuros = data.paidRevenueCents.map(v => v / 100);

      const revenueCtx = document.getElementById('revenueChart');
      const ordersCtx = document.getElementById('ordersChart');

      if (revenueCtx) {
        new Chart(revenueCtx, {
          type: 'line',
          data: {
            labels,
            datasets: [{
              label: 'CA (€)',
              data: revenueEuros,
              tension: 0.25,
              pointRadius: 2
            }]
          },
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
              x: { ticks: { color: axisColor }, grid: { color: gridColor } },
              y: {
                ticks: { color: axisColor, callback: (v) => v + ' €' },
                grid: { color: gridColor }
              }
            }
          }
        });
      }

      if (ordersCtx) {
        new Chart(ordersCtx, {
          type: 'bar',
          data: {
            labels,
            datasets: [{
              label: 'Commandes',
              data: data.paidCount
            }]
          },
          options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
              x: { ticks: { color: axisColor }, grid: { color: gridColor } },
              y: {
                beginAtZero: true,
                ticks: { color: axisColor, precision: 0 },
                grid: { color: gridColor }
              }
            }
          }
        });
      }
    })();
  </script>
{% endblock %}
