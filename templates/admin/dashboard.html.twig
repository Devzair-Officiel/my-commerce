{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Dashboard
{% endblock %}

{% block main %}
	<div
		class="container-fluid">

		{# ================= KPI PRINCIPAUX ================= #}
		<div class="row g-3 mb-3">
			<div class="col-12 col-md-4">
				<a class="card text-decoration-none h-100" href="{{ urls.products }}">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<div class="text-muted">Produits</div>
							<div class="fs-2 fw-bold">{{ counts.products }}</div>
						</div>
						<i class="fas fa-box fa-2x text-muted"></i>
					</div>
				</a>
			</div>

			<div class="col-12 col-md-4">
				<a class="card text-decoration-none h-100" href="{{ urls.users }}">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<div class="text-muted">Utilisateurs</div>
							<div class="fs-2 fw-bold">{{ counts.users }}</div>
						</div>
						<i class="fas fa-users fa-2x text-muted"></i>
					</div>
				</a>
			</div>

			<div class="col-12 col-md-4">
				<a class="card text-decoration-none h-100" href="{{ urls.categories }}">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<div class="text-muted">Catégories</div>
							<div class="fs-2 fw-bold">{{ counts.categories }}</div>
						</div>
						<i class="fas fa-tags fa-2x text-muted"></i>
					</div>
				</a>
			</div>
		</div>

		{# ================= KPI SECONDAIRES ================= #}
		<div class="row g-3 mb-3">
			<div class="col-6 col-md-3">
				<a class="card text-decoration-none text-center p-3" href="{{ urls.pages }}">
					<div class="fw-semibold">Pages</div>
					<div class="fs-4">{{ counts.pages }}</div>
				</a>
			</div>

			<div class="col-6 col-md-3">
				<a class="card text-decoration-none text-center p-3" href="{{ urls.sliders }}">
					<div class="fw-semibold">Sliders</div>
					<div class="fs-4">{{ counts.sliders }}</div>
				</a>
			</div>

			<div class="col-6 col-md-3">
				<a class="card text-decoration-none text-center p-3" href="{{ urls.paymentMethods }}">
					<div class="fw-semibold">Paiements</div>
					<div class="fs-4">{{ counts.paymentMethods }}</div>
				</a>
			</div>

			<div class="col-6 col-md-3">
				<a class="card text-decoration-none text-center p-3" href="{{ urls.carriers }}">
					<div class="fw-semibold">Transporteurs</div>
					<div class="fs-4">{{ counts.carriers }}</div>
				</a>
			</div>
		</div>

		{# ================= CHECKLIST + SETTINGS ================= #}
		<div class="row g-3">
			<div class="col-12 col-lg-6">
				<div class="card h-100">
					<div class="card-body">
						<div class="fw-semibold mb-2">Checklist “prêt à vendre”</div>

						<ul class="list-group list-group-flush">
							<li class="list-group-item">✔ Réglages du site</li>
							<li class="list-group-item">✔ Au moins 1 produit</li>
							<li class="list-group-item">✔ Au moins 1 catégorie</li>
							<li class="list-group-item">✔ Paiement configuré</li>
							<li class="list-group-item">✔ Transporteur configuré</li>
						</ul>
					</div>
				</div>
			</div>

			<div class="col-12 col-lg-6">
				<div class="card h-100">
					<div class="card-body d-flex justify-content-between align-items-center">
						<div>
							<div class="text-muted">Paramètres du site</div>
							<div class="fw-semibold">
								{% if setting %}
									{{ setting.websiteName }}
									—
									{{ setting.currency }}
								{% else %}
									Aucun setting trouvé
								{% endif %}
							</div>

							{% if setting %}
								<div class="text-muted small">
									{{ setting.street }},
									{{ setting.codePostal }}
									{{ setting.city }}
								</div>
							{% endif %}
						</div>

						<div class="d-flex gap-2">
							<a class="btn btn-outline-secondary" href="{{ urls.settings_index }}">
								Voir
							</a>

							{% if urls.settings_edit %}
								<a class="btn btn-primary" href="{{ urls.settings_edit }}">
									Modifier
								</a>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
{% endblock %}

