{# Rendu HTML de la structure des évaluations d'une fiche de dégustation. #}
<style>
	.ht-detail { font-size: .92rem; }
	.ht-detail__empty { color: #888; font-style: italic; }
	.ht-honey {
		border: 1px solid #e6e1d5;
		border-radius: 6px;
		padding: .85rem 1.1rem;
		margin-bottom: 1rem;
		background: #fbfaf6;
	}
	.ht-honey__name {
		font-size: 1.05rem;
		font-weight: 700;
		margin: 0 0 .5rem;
		padding-bottom: .35rem;
		border-bottom: 1px solid #e6e1d5;
	}
	.ht-section { margin: .5rem 0 .7rem; }
	.ht-section__title {
		font-size: .72rem;
		font-weight: 700;
		letter-spacing: .1em;
		text-transform: uppercase;
		color: #b6862c;
		margin: .35rem 0 .3rem;
	}
	.ht-entry { margin: .25rem 0 .25rem .35rem; }
	.ht-entry__label { font-weight: 600; }
	.ht-entry__values { color: #333; }
	.ht-entry--text .ht-entry__values {
		display: block;
		margin-top: .2rem;
		padding: .35rem .55rem;
		background: #fff;
		border-left: 3px solid #b6862c;
		white-space: pre-wrap;
	}
	.ht-chip {
		display: inline-block;
		padding: .1rem .55rem;
		margin: 0 .25rem .2rem 0;
		font-size: .82rem;
		background: #1c1a15;
		color: #fff;
		border-radius: 999px;
	}
</style>

<div class="ht-detail">
	{% if grouped is empty %}
		<p class="ht-detail__empty">Aucun descripteur renseigné dans cette fiche.</p>
	{% else %}
		{% for honey in grouped %}
			<div class="ht-honey">
				<h3 class="ht-honey__name">{{ honey.honeyName }}</h3>
				{% for section in honey.sections %}
					<div class="ht-section">
						<div class="ht-section__title">{{ section.title }}</div>
						{% for entry in section.entries %}
							<div class="ht-entry{% if entry.isText %} ht-entry--text{% endif %}">
								<span class="ht-entry__label">{{ entry.label }} :</span>
								{% if entry.isText %}
									<span class="ht-entry__values">{{ entry.values|first }}</span>
								{% else %}
									<span class="ht-entry__values">
										{% for v in entry.values %}<span class="ht-chip">{{ v }}</span>{% endfor %}
									</span>
								{% endif %}
							</div>
						{% endfor %}
					</div>
				{% endfor %}
			</div>
		{% endfor %}
	{% endif %}
</div>
