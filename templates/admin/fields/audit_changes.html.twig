{# Rendu du diff JSON — accès à l'array natif via l'instance EasyAdmin #}
{% set data = entity.instance.changes %}
{% set action = entity.instance.action.value %}

{% if data is iterable %}

{# ── Palette selon l'action ── #}
{% if action == 'CREATE' %}
    {% set color_header = '#0d6e3f' %}
    {% set color_bg     = '#0a2e1a' %}
    {% set color_badge  = '#198754' %}
    {% set color_label  = '#6ee7b7' %}
    {% set icon         = '✦' %}
    {% set action_label = 'Création' %}
{% elseif action == 'DELETE' %}
    {% set color_header = '#7f1d1d' %}
    {% set color_bg     = '#2d0b0b' %}
    {% set color_badge  = '#dc3545' %}
    {% set color_label  = '#fca5a5' %}
    {% set icon         = '✕' %}
    {% set action_label = 'Suppression' %}
{% else %}
    {% set color_header = '#78450c' %}
    {% set color_bg     = '#2a1a05' %}
    {% set color_badge  = '#fd7e14' %}
    {% set color_label  = '#fcd34d' %}
    {% set icon         = '✎' %}
    {% set action_label = 'Modification' %}
{% endif %}

<div style="font-family: 'Inter', system-ui, sans-serif; max-width: 860px;">

    {# ── UPDATE ── #}
    {% if data.changes is defined %}

        {% set total = data.changes|length %}
        <div style="margin-bottom: 12px; display:flex; align-items:center; gap:10px;">
            <span style="background:{{ color_badge }}; color:#fff; font-size:.7rem; font-weight:700;
                         padding:3px 10px; border-radius:20px; letter-spacing:.05em; text-transform:uppercase;">
                {{ icon }} {{ action_label }}
            </span>
            <span style="color:#9ca3af; font-size:.8rem;">{{ total }} champ{{ total > 1 ? 's' : '' }} modifié{{ total > 1 ? 's' : '' }}</span>
        </div>

        <div style="border-radius:10px; overflow:hidden; border:1px solid #374151;">
            <table style="width:100%; border-collapse:collapse; font-size:.82rem;">
                <thead>
                    <tr style="background:{{ color_header }};">
                        <th style="padding:10px 14px; color:#e5e7eb; font-weight:600; width:28%; text-align:left;">Champ</th>
                        <th style="padding:10px 14px; color:#fca5a5; font-weight:600; width:36%; text-align:left;">Avant</th>
                        <th style="padding:10px 14px; color:#6ee7b7; font-weight:600; width:36%; text-align:left;">Après</th>
                    </tr>
                </thead>
                <tbody>
                    {% for field_name, diff in data.changes %}
                    <tr style="border-top:1px solid #1f2937; background:{% if loop.index is odd %}#111827{% else %}#0d1117{% endif %};">
                        <td style="padding:9px 14px; color:#d1d5db;">
                            <code style="background:#1f2937; padding:2px 6px; border-radius:4px; font-size:.75rem; color:#93c5fd;">
                                {{ field_name|replace({'_': ' '})|title }}
                            </code>
                        </td>
                        <td style="padding:9px 14px; color:#f87171; word-break:break-all;">
                            {% if diff.before is not null %}
                                <span style="background:#450a0a; padding:2px 6px; border-radius:4px;">{{ diff.before }}</span>
                            {% else %}
                                <span style="color:#4b5563; font-style:italic;">vide</span>
                            {% endif %}
                        </td>
                        <td style="padding:9px 14px; color:#4ade80; word-break:break-all;">
                            {% if diff.after is not null %}
                                <span style="background:#052e16; padding:2px 6px; border-radius:4px;">{{ diff.after }}</span>
                            {% else %}
                                <span style="color:#4b5563; font-style:italic;">vide</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {# ── CREATE ── #}
    {% elseif data.after is defined %}

        {% set rows = [] %}
        {% for k, v in data.after %}{% if v is not null %}{% set rows = rows|merge([{k: k, v: v}]) %}{% endif %}{% endfor %}

        <div style="margin-bottom:12px; display:flex; align-items:center; gap:10px;">
            <span style="background:{{ color_badge }}; color:#fff; font-size:.7rem; font-weight:700;
                         padding:3px 10px; border-radius:20px; letter-spacing:.05em; text-transform:uppercase;">
                {{ icon }} {{ action_label }}
            </span>
            <span style="color:#9ca3af; font-size:.8rem;">{{ rows|length }} champ{{ rows|length > 1 ? 's' : '' }} initialisé{{ rows|length > 1 ? 's' : '' }}</span>
        </div>

        <div style="border-radius:10px; overflow:hidden; border:1px solid #374151;">
            <table style="width:100%; border-collapse:collapse; font-size:.82rem;">
                <thead>
                    <tr style="background:{{ color_header }};">
                        <th style="padding:10px 14px; color:#e5e7eb; font-weight:600; width:35%; text-align:left;">Champ</th>
                        <th style="padding:10px 14px; color:{{ color_label }}; font-weight:600; text-align:left;">Valeur initiale</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                    <tr style="border-top:1px solid #1f2937; background:{% if loop.index is odd %}#111827{% else %}#0d1117{% endif %};">
                        <td style="padding:9px 14px;">
                            <code style="background:#1f2937; padding:2px 6px; border-radius:4px; font-size:.75rem; color:#93c5fd;">
                                {{ row.k|replace({'_': ' '})|title }}
                            </code>
                        </td>
                        <td style="padding:9px 14px; color:#d1d5db; word-break:break-all;">{{ row.v }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {# ── DELETE ── #}
    {% elseif data.before is defined %}

        {% set rows = [] %}
        {% for k, v in data.before %}{% if v is not null %}{% set rows = rows|merge([{k: k, v: v}]) %}{% endif %}{% endfor %}

        <div style="margin-bottom:12px; display:flex; align-items:center; gap:10px;">
            <span style="background:{{ color_badge }}; color:#fff; font-size:.7rem; font-weight:700;
                         padding:3px 10px; border-radius:20px; letter-spacing:.05em; text-transform:uppercase;">
                {{ icon }} {{ action_label }}
            </span>
            <span style="color:#9ca3af; font-size:.8rem;">Snapshot avant suppression — {{ rows|length }} champ{{ rows|length > 1 ? 's' : '' }}</span>
        </div>

        <div style="border-radius:10px; overflow:hidden; border:1px solid #374151;">
            <table style="width:100%; border-collapse:collapse; font-size:.82rem;">
                <thead>
                    <tr style="background:{{ color_header }};">
                        <th style="padding:10px 14px; color:#e5e7eb; font-weight:600; width:35%; text-align:left;">Champ</th>
                        <th style="padding:10px 14px; color:{{ color_label }}; font-weight:600; text-align:left;">Valeur supprimée</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                    <tr style="border-top:1px solid #1f2937; background:{% if loop.index is odd %}#111827{% else %}#0d1117{% endif %};">
                        <td style="padding:9px 14px;">
                            <code style="background:#1f2937; padding:2px 6px; border-radius:4px; font-size:.75rem; color:#93c5fd;">
                                {{ row.k|replace({'_': ' '})|title }}
                            </code>
                        </td>
                        <td style="padding:9px 14px; color:#f87171; word-break:break-all; text-decoration:line-through; opacity:.8;">
                            {{ row.v }}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {% endif %}

</div>

{% else %}
    <span style="color:#6b7280; font-style:italic;">Aucune donnée</span>
{% endif %}
