{% extends 'base.html.twig' %}

{% block title %}
	{{globalSetting.website_name}}
	| Payment success
{% endblock %}


{% block body %}

	{% include "page_head/index.html.twig" with {'page_name': "✅ Commande validé" } %}

	<div class="section">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-md-8">
					<div class="text-center order_complete">
						<svg class="icon icon--xl" aria-hidden="true"><use href="#icon-check-circle"></use></svg>
						<div class="heading_s1">
							<h3>Votre commande a bien été prise en compte</h3>
						</div>
						<p>
							Merci pour votre achat. Nous avons bien reçu votre commande et nous vous enverrons un email de confirmation avec les détails de votre commande.
						</p>
						{% if order is defined and order %}
							<p class="text-muted">Commande : {{ order.orderReference }}</p>
						{% endif %}
						<a href="{{ path('app_account') }}" class="btn btn-fill-out">
							Retour vers mon compte
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
