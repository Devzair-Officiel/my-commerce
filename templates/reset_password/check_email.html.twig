{% extends 'base.html.twig' %}

{% block title %}Email envoyé |
	{{ globalSetting.website_name }}
{% endblock %}

{% block body %}

	{% include "page_head/index.html.twig" with {'page_name' : 'Vérifiez votre boîte mail'} %}

	<div class="main_content">
		<div class="login_register_wrap section">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-xl-6 col-md-10">
						<div class="login_wrap">
							<div class="padding_eight_all bg-white">

								<div class="heading_s1">
									<h3>Vérifiez votre boîte mail</h3>
								</div>

								<div class="alert alert-info mb-4" role="alert">
									Si un compte correspond à l’adresse indiquée, un email de réinitialisation vient d’être envoyé.
								</div>

								<p class="mb-3">
									Le lien de réinitialisation expirera
									<strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
								</p>

								<p class="mb-4">
									Si vous ne recevez rien, vérifiez vos spams ou recommencez avec la même adresse email.
								</p>

								<div class="form-group mb-3">
									<a href="{{ path('app_forgot_password_request') }}" class="btn btn-fill-out btn-block">
										Renvoyer un email
									</a>
								</div>

								<div class="form-note text-center mt-3">
									<a href="{{ path('app_login') }}">Retour à la connexion</a>
								</div>

							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
