<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<title>Carnet de dégustation — {{ tasting.tasterName }}</title>
	<style>
		@page { margin: 22mm 18mm 18mm; }
		* { box-sizing: border-box; }
		body {
			font-family: 'DejaVu Sans', sans-serif;
			color: #1c1a15;
			font-size: 10pt;
			line-height: 1.45;
			margin: 0;
		}
		.header {
			border-bottom: 2px solid #1c1a15;
			padding-bottom: 8pt;
			margin-bottom: 14pt;
		}
		.kicker {
			font-size: 8pt;
			letter-spacing: 2pt;
			text-transform: uppercase;
			color: #b6862c;
			font-weight: bold;
		}
		h1 {
			font-size: 18pt;
			margin: 2pt 0 4pt;
			font-weight: bold;
		}
		.meta {
			font-size: 9pt;
			color: #555;
		}
		.meta strong { color: #1c1a15; }
		.honey {
			page-break-inside: avoid;
			margin-bottom: 14pt;
			border: 1px solid #ccc;
			padding: 10pt 12pt;
		}
		.honey + .honey { page-break-before: auto; }
		.honey__name {
			font-size: 13pt;
			font-weight: bold;
			margin: 0 0 6pt;
			border-bottom: 1px solid #e6e1d5;
			padding-bottom: 4pt;
		}
		.section {
			margin-bottom: 8pt;
		}
		.section__title {
			font-size: 10pt;
			font-weight: bold;
			color: #b6862c;
			text-transform: uppercase;
			letter-spacing: 1pt;
			margin: 4pt 0 4pt;
		}
		.entry {
			margin-bottom: 3pt;
			padding-left: 4pt;
		}
		.entry__label {
			font-weight: bold;
			font-size: 9pt;
		}
		.entry__values {
			font-size: 9.5pt;
		}
		.entry--text .entry__values {
			display: block;
			margin-top: 2pt;
			padding: 4pt 6pt;
			background: #fbfaf6;
			border-left: 2pt solid #b6862c;
			white-space: pre-wrap;
		}
		.entry__note {
			display: block;
			margin-top: 2pt;
			padding: 3pt 5pt;
			font-size: 9pt;
			font-style: italic;
			color: #555;
			background: #fff;
			border-left: 1.5pt solid #b6862c;
		}
		.empty {
			font-style: italic;
			color: #888;
			margin-top: 20pt;
			text-align: center;
		}
		.footer {
			position: fixed;
			bottom: -12mm;
			left: 0;
			right: 0;
			text-align: center;
			font-size: 8pt;
			color: #888;
		}
	</style>
</head>
<body>

<div class="header">
	<div class="kicker">Carnet de dégustation</div>
	<h1>Fiche sensorielle des miels</h1>
	<div class="meta">
		<strong>Dégustateur :</strong> {{ tasting.tasterName }}
		&nbsp;·&nbsp;
		<strong>Date :</strong> {{ tasting.createdAt|date('d/m/Y à H:i') }}
	</div>
</div>

{% if grouped is empty %}
	<p class="empty">Aucun descripteur renseigné dans cette fiche.</p>
{% else %}
	{% for honey in grouped %}
		<div class="honey">
			<h2 class="honey__name">{{ honey.honeyName }}</h2>
			{% for section in honey.sections %}
				<div class="section">
					<div class="section__title">{{ section.title }}</div>
					{% for entry in section.entries %}
						<div class="entry{% if entry.isText %} entry--text{% endif %}">
							<span class="entry__label">{{ entry.label }} :</span>
							<span class="entry__values">{{ entry.values|join(', ') }}</span>
							{% if entry.note is defined and entry.note %}
								<div class="entry__note">{{ entry.note }}</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			{% endfor %}
		</div>
	{% endfor %}
{% endif %}

</body>
</html>
