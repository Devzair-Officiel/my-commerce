<header class="header_wrap fixed-top header_with_topbar active" role="banner">
	<div style="background-color: #b35500; text-align: center;">
		<p style="color: white; font-style: italic; margin: 0;">
			Profitez des frais de livraison OFFERTS à partir de 50€ d'achat
		</p>
	</div>

	<div class="top-header">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-md-6">
					<ul class="contact_detail text-center text-lg-start" aria-label="Informations de contact">
						<li>
							<svg class="icon" aria-hidden="true"><use href="#icon-phone"></use></svg>
							<span>{{ globalSetting.phone }}</span>
						</li>
					</ul>
				</div>

				<div class="col-md-6">
					<ul class="header_list text-center text-md-end">
						<li>
							<a href="/compare" aria-label="Comparateur">
								<svg class="icon icon--xl" aria-hidden="true"><use href="#icon-shuffle"></use></svg>
							</a>
						</li>
						<li>
							<a href="/wishlist" aria-label="Liste d'envies">
								<svg class="icon icon--xl" aria-hidden="true"><use href="#icon-heart"></use></svg>
							</a>
						</li>

						{% if app.user %}
							{% if is_granted('ROLE_ADMIN') %}
								<li>
									<a href="/admin" aria-label="Espace administrateur">
										<svg class="icon icon--xl" aria-hidden="true"><use href="#icon-user"></use></svg>
									</a>
								</li>
							{% else %}
								<li>
									<a href="/account" aria-label="Mon compte">
										<svg class="icon icon--xl" aria-hidden="true"><use href="#icon-user"></use></svg>
									</a>
								</li>
							{% endif %}
							<li>
								<a href="/logout" aria-label="Me déconnecter">
									<svg class="icon icon--xl" aria-hidden="true"><use href="#icon-logout"></use></svg>
								</a>
							</li>
						{% else %}
							<li>
								<a href="/login" aria-label="Connexion">Connexion</a>
								/
								<a href="/register" aria-label="Créer un compte">Créer un compte</a>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</div>
	</div>
	<div class="bottom_header dark_skin main_menu_uppercase">
		<div class="container">
			<nav class="navbar navbar-expand-lg" role="navigation">
				<div class="d-flex align-items-center">
					<a href="/" class="navbar-brand d-flex align-items-center" aria-label="Retour à l'accueil">
						{% if globalSetting.logo_filename %}
							<img src="/assets/images/setting/{{ globalSetting.logo_filename }}" alt="{{ globalSetting.logo_alt ?? globalSetting.website_name }}" width="160" height="48" fetchpriority="high" decoding="async">
						{% else %}
							<span style="font-size:1.4rem;font-weight:700;">{{ globalSetting.website_name }}</span>
						{% endif %}
					</a>
				</div>

				<button type="button" class="navbar-toggler collapsed" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-expanded="false" aria-label="Menu principal">
					<svg class="icon" aria-hidden="true"><use href="#icon-menu"></use></svg>
				</button>

				<div class="collapse navbar-collapse justify-content-end" id="navbarSupportedContent">
					<ul class="navbar-nav">
						<li>
							<a class="nav-link" href="/">Nos miels</a>
						</li>
						<li class="dropdown">
							<a href="#" class="dropdown-toggle nav-link" data-bs-toggle="dropdown" aria-expanded="false">A propos</a>
							<div class="dropdown-menu">
								<ul>
									{% for page in globalHeaderPages %}
										<li>
											<a class="dropdown-item nav-link nav_item" href="/page/{{ page.slug }}">{{ page.title }}</a>
										</li>
									{% endfor %}
                                    <li>
                                        <a class="dropdown-item nav-link nav_item" href="/faq-miel"> FAQ </a>
                                    </li>
								</ul>
							</div>
						</li>
						<li>
							<a class="nav-link" href="/blog">Blog</a>
						</li>
						<li>
							<a class="nav-link nav_item" href="/contact">Contact</a>
						</li>
					</ul>
				</div>

				<ul class="navbar-nav attr-nav align-items-center">
					<li>
						<a href="#" class="nav-link search_trigger" aria-label="Recherche">
							<svg class="icon" aria-hidden="true"><use href="#icon-search"></use></svg>
						</a>
						<div class="search_wrap">
							<form action="/product/search" method="get">
								<input type="text" name="term" placeholder="Rechercher un miel..." class="form-control" aria-label="Champ de recherche">
								<button type="submit" class="search_icon" aria-label="Valider la recherche">
									<svg class="icon" aria-hidden="true"><use href="#icon-search"></use></svg>
								</button>
							</form>
						</div>
					</li>

					<li class="dropdown cart_dropdown">
						<a href="#" class="nav-link cart_trigger" data-bs-toggle="dropdown" aria-label="Panier">
							<svg class="icon" aria-hidden="true"><use href="#icon-cart"></use></svg>
							<span class="cart_count"></span>
						</a>
						<div class="cart_box dropdown-menu dropdown-menu-right">
							<ul class="cart_list"></ul>
							<div class="cart_footer">
								<p class="cart_total_ht cart_total">
									<strong>Sous-total HT:</strong>
									<span class="cart_price_value_ht"></span>
								</p>
								<p class="cart_taxe cart_total">
									<strong>Taxe:</strong>
									<span class="cart_taxe_value"></span>
								</p>
								<p class="cart_total_ttc cart_total">
									<strong>Sous-total TTC:</strong>
									<span class="cart_price_value_ttc"></span>
								</p>
								<p class="cart_buttons">
									<a class="btn btn-fill-line view-cart" href="/cart">Mon panier</a>
									<a class="btn btn-fill-out checkout" href="/checkout">Paiement</a>
								</p>
							</div>
						</div>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</header>

