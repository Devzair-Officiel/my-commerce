{% extends 'base.html.twig' %}

{% block title %}{{globalSetting.website_name}} | A propos
	{{page.title}}
{% endblock %}

{% block body %}

    {% include 'page_head/index.html.twig' with {
		'page_name': page.title,
		breadcrumbs: [{ label: page.title }]
	} %}

	<div class="main_content">
		<div class="section">
			<div class="container">
				{{ page.content|normalize_editor_html|raw }}
			</div>
		</div>
	</div>

{% endblock %}

