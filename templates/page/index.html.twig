{% extends 'base.html.twig' %}

{% block title %} {{globalSetting.website_name}} | {{page.title}} {% endblock %}

{% block body %}

    {% include 'page_head/index.html.twig' with {
		'page_name': page.title,
		breadcrumbs: [{ label: page.title }]
	} %}

	<div class="main_content nide-page">
		<div class="container">
			<div class="nide-page-content">
				{{ page.content|normalize_editor_html|raw }}
			</div>

			{% if page.slug == 'qualite-et-analyses' %}
				<p class="nide-page-guide-link">
					Pour comprendre comment lire ces analyses au quotidien,
					<a href="{{ path('app_guide_sensoriel') }}#analyses">consultez notre guide sensoriel</a>.
				</p>
			{% endif %}
		</div>
	</div>

{% endblock %}

