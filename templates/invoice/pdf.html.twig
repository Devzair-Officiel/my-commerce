<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: DejaVu Sans, sans-serif; font-size: 11px; color: #222; }
        .page { padding: 36px 44px; }

        /* ── En-tête ── */
        .header { display: table; width: 100%; margin-bottom: 32px; }
        .header-left, .header-right { display: table-cell; vertical-align: top; }
        .header-left { width: 55%; }
        .header-right { width: 45%; text-align: right; }

        .logo-img { max-height: 52px; max-width: 180px; }
        .logo-text { font-size: 22px; font-weight: bold; color: #e37e03; }

        .seller-info { margin-top: 8px; font-size: 10.5px; color: #555; line-height: 1.7; }

        .invoice-title { font-size: 28px; font-weight: bold; color: #333; letter-spacing: 1px; }
        .invoice-meta { margin-top: 6px; font-size: 11px; color: #555; line-height: 1.8; }
        .invoice-meta strong { color: #222; }

        /* ── Client ── */
        .client-block { margin-bottom: 24px; }
        .client-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: #999; margin-bottom: 5px; }
        .client-name { font-weight: bold; font-size: 12px; margin-bottom: 2px; }
        .client-line { font-size: 11px; color: #444; line-height: 1.6; }

        /* ── Référence ── */
        .ref-bar { background: #f7f7f7; border-left: 3px solid #e37e03; padding: 8px 12px; margin-bottom: 24px; font-size: 11px; color: #555; }

        /* ── Tableau ── */
        table.items { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        table.items thead th { background: #e37e03; color: #fff; padding: 8px 10px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; }
        table.items thead th.right { text-align: right; }
        table.items tbody tr:nth-child(even) { background: #fafafa; }
        table.items tbody td { padding: 7px 10px; border-bottom: 1px solid #eee; font-size: 11px; }
        table.items tbody td.right { text-align: right; }

        /* ── Totaux ── */
        .totals { float: right; width: 260px; margin-bottom: 30px; }
        .total-row { display: table; width: 100%; padding: 5px 0; border-bottom: 1px solid #eee; }
        .total-label { display: table-cell; color: #555; }
        .total-value { display: table-cell; text-align: right; font-weight: bold; }
        .total-row.grand { border-top: 2px solid #e37e03; border-bottom: none; margin-top: 4px; padding-top: 8px; }
        .total-row.grand .total-label,
        .total-row.grand .total-value { font-size: 14px; color: #e37e03; }

        .clearfix { clear: both; }

        /* ── Mentions légales ── */
        .legal { margin-top: 30px; padding-top: 14px; border-top: 1px solid #ddd; font-size: 9.5px; color: #888; line-height: 1.7; }

        .divider { border: none; border-top: 1px solid #e8e8e8; margin: 20px 0; }
    </style>
</head>
<body>
<div class="page">

    {# ── En-tête : logo + infos vendeur à gauche | titre facture à droite ── #}
    <div class="header">
        <div class="header-left">
            {% if logoPath %}
                <img src="{{ logoPath }}" alt="{{ seller.website_name }}" class="logo-img">
            {% else %}
                <div class="logo-text">{{ seller.website_name }}</div>
            {% endif %}
            <div class="seller-info">
                {% if seller.name %}{{ seller.name }}<br>{% endif %}
                {% if seller.street %}{{ seller.street }}<br>{% endif %}
                {{ seller.code_postal }} {{ seller.city }}{% if seller.state %}, {{ seller.state }}{% endif %}<br>
                {% if seller.siret %}SIRET : {{ seller.siret }}<br>{% endif %}
                {% if seller.phone %}Tél : {{ seller.phone }}<br>{% endif %}
                {% if seller.email %}{{ seller.email }}{% endif %}
            </div>
        </div>
        <div class="header-right">
            <div class="invoice-title">FACTURE</div>
            <div class="invoice-meta">
                <strong>N°</strong> {{ invoice.invoiceNumber }}<br>
                <strong>Date :</strong> {{ invoice.issuedAt ? invoice.issuedAt|date('d/m/Y', 'Europe/Paris') : '—' }}
            </div>
        </div>
    </div>

    <hr class="divider">

    {# ── Facturé à ── #}
    <div class="client-block">
        <div class="client-label">Facturé à</div>
        {% set customerName = (order.user.firstname ?? '') ~ ' ' ~ (order.user.lastname ?? '') %}
        {% if billingAddress %}
            <div class="client-name">{{ billingAddress.client_name ?? customerName|trim }}</div>
            <div class="client-line">
                {% if billingAddress.street ?? false %}{{ billingAddress.street }}<br>{% endif %}
                {{ billingAddress.code_postal ?? '' }} {{ billingAddress.city ?? '' }}<br>
                {% if billingAddress.state ?? false %}{{ billingAddress.state }}<br>{% endif %}
                {{ order.user.email }}
            </div>
        {% else %}
            {% if customerName|trim %}
                <div class="client-name">{{ customerName|trim }}</div>
            {% endif %}
            <div class="client-line">{{ order.user.email }}</div>
        {% endif %}
    </div>

    {# ── Référence commande ── #}
    <div class="ref-bar">
        Référence commande : <strong>{{ order.orderReference }}</strong>
        &nbsp;|&nbsp;
        Payée le : <strong>{{ seller.paid_at ?? '—' }}</strong>
        &nbsp;|&nbsp;
        Mode de paiement : <strong>{{ seller.payment_method_name ?? '—' }}</strong>
    </div>

    {# ── Lignes de commande ── #}
    <table class="items">
        <thead>
            <tr>
                <th style="width: 45%;">Désignation</th>
                <th class="right" style="width: 20%;">Prix unitaire</th>
                <th class="right" style="width: 10%;">Qté</th>
                <th class="right" style="width: 25%;">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for line in order.orderDetails %}
            <tr>
                <td>{{ line.productName }}</td>
                <td class="right">{{ (line.unitPriceCents / 100)|number_format(2, ',', ' ') }} €</td>
                <td class="right">{{ line.quantity }}</td>
                <td class="right">{{ (line.lineTotalCents / 100)|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endfor %}
            {% if order.carrierPriceSnapshotCents > 0 %}
            <tr>
                <td>Frais de livraison — {{ order.carrierNameSnapshot }}</td>
                <td class="right">{{ (order.carrierPriceSnapshotCents / 100)|number_format(2, ',', ' ') }} €</td>
                <td class="right">1</td>
                <td class="right">{{ (order.carrierPriceSnapshotCents / 100)|number_format(2, ',', ' ') }} €</td>
            </tr>
            {% endif %}
        </tbody>
    </table>

    {# ── Totaux ── #}
    <div class="totals">
        <div class="total-row">
            <span class="total-label">Sous-total HT</span>
            <span class="total-value">{{ (order.itemsTotalHtCents / 100)|number_format(2, ',', ' ') }} €</span>
        </div>
        {% if order.carrierPriceSnapshotCents > 0 %}
        <div class="total-row">
            <span class="total-label">Livraison</span>
            <span class="total-value">{{ (order.carrierPriceSnapshotCents / 100)|number_format(2, ',', ' ') }} €</span>
        </div>
        {% endif %}
        {% if taxAmountCents > 0 %}
        <div class="total-row">
            <span class="total-label">TVA</span>
            <span class="total-value">{{ (taxAmountCents / 100)|number_format(2, ',', ' ') }} €</span>
        </div>
        {% else %}
        <div class="total-row">
            <span class="total-label">TVA</span>
            <span class="total-value">Non applicable</span>
        </div>
        {% endif %}
        <div class="total-row grand">
            <span class="total-label">Total TTC</span>
            <span class="total-value">{{ (order.orderTotalTtcCents / 100)|number_format(2, ',', ' ') }} €</span>
        </div>
    </div>

    <div class="clearfix"></div>

    {# ── Mentions légales ── #}
    <div class="legal">
        {% if invoice.notes %}
            {% for line in invoice.notes|split("\n") %}{{ line }}<br>{% endfor %}
        {% endif %}
        {% if seller.legal_mentions %}<br>{{ seller.legal_mentions }}{% endif %}
    </div>

</div>
</body>
</html>
