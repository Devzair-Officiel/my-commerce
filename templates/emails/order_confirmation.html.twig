{% set orderDate = order.paidAt ?? order.createdAt ?? null %}
{% set shippingCost = order.carrierPriceSnapshotCents ?? 0 %}
{% set itemsTotalHt = order.itemsTotalHtCents ?? 0 %}
{% set taxAmount = order.taxAmountCents ?? 0 %}
{% set totalTtc = order.orderTotalTtcCents ?? 0 %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Confirmation de commande</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
            font-family: Arial, Helvetica, sans-serif;
            color: #1f2937;
        }

        table {
            border-spacing: 0;
        }

        img {
            border: 0;
            display: block;
            max-width: 100%;
        }

        .wrapper {
            width: 100%;
            background-color: #f4f4f4;
            padding: 24px 0;
        }

        .container {
            width: 100%;
            max-width: 700px;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
        }

        .section-padding {
            padding: 24px;
        }

        .box {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            overflow: hidden;
        }

        .box-title {
            background-color: #f9fafb;
            padding: 14px 16px;
            font-size: 16px;
            font-weight: bold;
            color: #111827;
            border-bottom: 1px solid #e5e7eb;
        }

        .cell {
            padding: 12px 16px;
            font-size: 14px;
            color: #111827;
            border-bottom: 1px solid #e5e7eb;
        }

        .cell-muted {
            color: #6b7280;
        }

        .product-image {
            width: 72px;
        }

        .product-image img {
            width: 64px;
            height: 64px;
            object-fit: cover;
            border-radius: 8px;
            background-color: #f3f4f6;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        @media only screen and (max-width: 600px) {
            .section-padding {
                padding: 16px !important;
            }

            .mobile-block,
            .mobile-block tbody,
            .mobile-block tr,
            .mobile-block td {
                display: block !important;
                width: 100% !important;
            }

            .mobile-stack {
                display: block !important;
                width: 100% !important;
            }

            .product-image {
                width: 100% !important;
                padding-bottom: 8px !important;
            }

            .product-image img {
                width: 56px !important;
                height: 56px !important;
            }

            .text-right,
            .text-center {
                text-align: left !important;
            }
        }
    </style>
</head>
<body>
<table role="presentation" width="100%" class="wrapper">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" class="container">
                <tr>
                    <td style="background-color:#111827; padding:32px 24px; text-align:center;">
                        <h1 style="margin:0; font-size:28px; line-height:1.2; color:#ffffff;">Merci pour votre commande</h1>
                        <p style="margin:12px 0 0; font-size:16px; color:#e5e7eb;">
                            Votre commande chez {{ globalSetting.website_name }} a bien été prise en compte.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td class="section-padding">
                        <p style="margin:0 0 16px; font-size:16px; line-height:1.6;">
                            Bonjour {{ user.firstname ?? user.email }},
                        </p>
                        <p style="margin:0; font-size:15px; line-height:1.7; color:#374151;">
                            Nous confirmons la bonne prise en compte de votre commande.
                            Nous vous informerons par e-mail dès qu'elle sera expédiée.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td class="section-padding" style="padding-top:0;">
                        <table role="presentation" width="100%" class="box">
                            <tr>
                                <td colspan="2" class="box-title">Récapitulatif de la commande</td>
                            </tr>
                            <tr>
                                <td class="cell cell-muted" style="width:45%;">Référence</td>
                                <td class="cell"><strong>{{ order.orderReference ?? '-' }}</strong></td>
                            </tr>
                            <tr>
                                <td class="cell cell-muted">Date de commande</td>
                                <td class="cell">
                                    {% if orderDate %}
                                        {{ orderDate|date('d/m/Y à H:i', 'Europe/Paris') }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <td class="cell cell-muted">Adresse de livraison</td>
                                <td class="cell" style="line-height:1.6;">
                                    {% if order.shippingAddress %}
                                        {{ order.shippingAddress|nl2br }}
                                    {% else %}
                                        Adresse non renseignée
                                    {% endif %}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td class="section-padding" style="padding-top:0;">
                        <table role="presentation" width="100%" class="box">
                            <tr>
                                <td colspan="4" class="box-title">Détail des articles</td>
                            </tr>

                            {% for detail in order.orderDetails %}
                                <tr>
                                    <td class="cell product-image mobile-stack">
                                        {% if detail.productImageUrl %}
                                            <img
                                                src="{{ detail.productImageUrl }}"
                                                alt="{{ detail.productImageAlt ?: detail.productName }}"
                                                width="64"
                                                height="64"
                                                style="width:64px; height:64px; object-fit:cover; border-radius:8px; background-color:#f3f4f6;"
                                            >
                                        {% else %}
                                            <div style="width:64px; height:64px; border-radius:8px; background:#f3f4f6;"></div>
                                        {% endif %}
                                    </td>

                                    <td class="cell mobile-stack" style="line-height:1.5;">
                                        <strong>{{ detail.productName }}</strong>
                                        {% if detail.productDescription %}
                                            <br>
                                            <span style="font-size:12px; color:#6b7280;">
                                                {{ detail.productDescription|striptags|u.truncate(120, '…') }}
                                            </span>
                                        {% endif %}
                                    </td>

                                    <td class="cell text-center mobile-stack">
                                        Qté : {{ detail.quantity }}
                                    </td>

                                    <td class="cell text-right mobile-stack">
                                        <div>{{ ((detail.unitPriceCents ?? 0) / 100)|number_format(2, ',', ' ') }} € / unité</div>
                                        <div style="margin-top:6px; font-weight:bold;">
                                            {{ ((detail.lineTotalCents ?? 0) / 100)|number_format(2, ',', ' ') }} €
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </td>
                </tr>

                <tr>
                    <td class="section-padding" style="padding-top:0; padding-bottom:32px;">
                        <table role="presentation" width="100%" class="box">
                            <tr>
                                <td colspan="2" class="box-title">Montants</td>
                            </tr>
                            <tr>
                                <td class="cell">Sous-total HT</td>
                                <td class="cell text-right">{{ (itemsTotalHt / 100)|number_format(2, ',', ' ') }} €</td>
                            </tr>
                            <tr>
                                <td class="cell">
                                    Livraison{% if order.carrierNameSnapshot %} ({{ order.carrierNameSnapshot }}){% endif %}
                                </td>
                                <td class="cell text-right">{{ (shippingCost / 100)|number_format(2, ',', ' ') }} €</td>
                            </tr>
                            <tr>
                                <td class="cell">TVA</td>
                                <td class="cell text-right">{{ ((taxAmount ?? 0) / 100)|number_format(2, ',', ' ') }} €</td>
                            </tr>
                            <tr>
                                <td class="cell" style="font-size:16px; font-weight:bold;">Total TTC</td>
                                <td class="cell text-right" style="font-size:18px; font-weight:bold;">{{ (totalTtc / 100)|number_format(2, ',', ' ') }} €</td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td style="padding:0 24px 32px;">
                        <p style="margin:0; font-size:14px; line-height:1.7; color:#6b7280;">
                            Merci pour votre confiance,<br>
                            L’équipe {{ globalSetting.website_name }}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
