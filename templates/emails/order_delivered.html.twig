<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Votre commande a été livrée</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif; color: #1f2937; }
        table { border-spacing: 0; }
        .wrapper { width: 100%; background-color: #f4f4f4; padding: 24px 0; }
        .container { width: 100%; max-width: 700px; background-color: #ffffff; border-radius: 12px; overflow: hidden; }
        .section-padding { padding: 24px; }
        .box { border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; }
        .box-title { background-color: #f9fafb; padding: 14px 16px; font-size: 16px; font-weight: bold; color: #111827; border-bottom: 1px solid #e5e7eb; }
        .cell { padding: 12px 16px; font-size: 14px; color: #111827; border-bottom: 1px solid #e5e7eb; }
        .cell-muted { color: #6b7280; }
    </style>
</head>
<body>
<table role="presentation" width="100%" class="wrapper">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" class="container">

                {# ── Header ── #}
                <tr>
                    <td style="background-color:#16a34a; padding:32px 24px; text-align:center;">
                        <h1 style="margin:0; font-size:28px; line-height:1.2; color:#ffffff;">
                            Votre commande a été livrée !
                        </h1>
                        <p style="margin:12px 0 0; font-size:16px; color:#bbf7d0;">
                            Commande {{ order.orderReference ?? '#' ~ order.id }}
                        </p>
                    </td>
                </tr>

                {# ── Message ── #}
                <tr>
                    <td class="section-padding">
                        <p style="margin:0 0 16px; font-size:16px; line-height:1.6;">
                            Bonjour {{ user.firstname ?? user.email }},
                        </p>
                        <p style="margin:0; font-size:15px; line-height:1.7; color:#374151;">
                            Bonne nouvelle ! Votre commande vient d'être livrée.
                            Nous espérons que vous êtes satisfait(e) de votre achat.
                        </p>
                    </td>
                </tr>

                {# ── Détails livraison ── #}
                <tr>
                    <td class="section-padding" style="padding-top:0; padding-bottom:32px;">
                        <table role="presentation" width="100%" class="box">
                            <tr>
                                <td colspan="2" class="box-title">Détails de la livraison</td>
                            </tr>
                            <tr>
                                <td class="cell cell-muted" style="width:45%;">Référence commande</td>
                                <td class="cell"><strong>{{ order.orderReference ?? '-' }}</strong></td>
                            </tr>
                            {% if shipment.deliveredAt %}
                            <tr>
                                <td class="cell cell-muted">Livré le</td>
                                <td class="cell"><strong>{{ shipment.deliveredAt|date('d/m/Y à H:i') }}</strong></td>
                            </tr>
                            {% endif %}
                            {% if order.carrierNameSnapshot %}
                            <tr>
                                <td class="cell cell-muted">Transporteur</td>
                                <td class="cell">{{ order.carrierNameSnapshot }}</td>
                            </tr>
                            {% endif %}
                            {% if shipment.trackingNumber and shipment.trackingNumber != 'À renseigner' %}
                            <tr>
                                <td class="cell cell-muted">N° de suivi</td>
                                <td class="cell"><strong>{{ shipment.trackingNumber }}</strong></td>
                            </tr>
                            {% endif %}
                            {% set pp = order.pickupPoint %}
                            {% if pp %}
                            <tr>
                                <td class="cell cell-muted">Point relais</td>
                                <td class="cell" style="line-height:1.6;">
                                    <strong>{{ pp.name }}</strong><br>
                                    {{ pp.address }}<br>
                                    {{ pp.postalCode }} {{ pp.city }}
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td class="cell cell-muted">Adresse de livraison</td>
                                <td class="cell" style="line-height:1.6;">
                                    {{ order.shippingAddress ? order.shippingAddress|nl2br : 'Non renseignée' }}
                                </td>
                            </tr>
                            {% endif %}
                        </table>
                    </td>
                </tr>

                {# ── Footer ── #}
                <tr>
                    <td style="padding:0 24px 32px;">
                        <p style="margin:0; font-size:14px; line-height:1.7; color:#6b7280;">
                            Merci pour votre confiance,<br>
                            L'équipe {{ globalSetting.website_name }}
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
</body>
</html>
