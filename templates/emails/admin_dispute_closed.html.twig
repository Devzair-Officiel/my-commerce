<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Contestation clôturée</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { margin: 0; padding: 0; background-color: #f4f4f4; font-family: Arial, Helvetica, sans-serif; color: #1f2937; }
        table { border-spacing: 0; }
        .wrapper { width: 100%; background-color: #f4f4f4; padding: 24px 0; }
        .container { width: 100%; max-width: 700px; background-color: #ffffff; border-radius: 12px; overflow: hidden; }
        .section-padding { padding: 24px; }
        .box { border: 1px solid #e5e7eb; border-radius: 10px; overflow: hidden; margin-top: 16px; }
        .box-title { background-color: #f9fafb; padding: 14px 16px; font-size: 16px; font-weight: bold; color: #111827; border-bottom: 1px solid #e5e7eb; }
        .cell { padding: 12px 16px; font-size: 14px; color: #111827; border-bottom: 1px solid #e5e7eb; }
        .cell-muted { color: #6b7280; }
        .text-right { text-align: right; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 9999px; font-size: 13px; font-weight: bold; }
        .badge-green { background-color: #dcfce7; color: #166534; }
        .badge-red { background-color: #fee2e2; color: #991b1b; }
        .badge-gray { background-color: #f3f4f6; color: #374151; }
    </style>
</head>
<body>
<table role="presentation" width="100%" class="wrapper">
    <tr>
        <td align="center">
            <table role="presentation" width="100%" class="container">
                <tr>
                    {% if status == 'won' %}
                        <td style="background-color:#14532d; padding:32px 24px; text-align:center;">
                            <h1 style="margin:0; font-size:26px; color:#ffffff;">✅ Contestation gagnée</h1>
                            <p style="margin:12px 0 0; font-size:15px; color:#bbf7d0;">La banque a statué en votre faveur. Le montant a été crédité.</p>
                        </td>
                    {% elseif status == 'lost' %}
                        <td style="background-color:#7f1d1d; padding:32px 24px; text-align:center;">
                            <h1 style="margin:0; font-size:26px; color:#ffffff;">❌ Contestation perdue</h1>
                            <p style="margin:12px 0 0; font-size:15px; color:#fca5a5;">La banque a statué en faveur du client. Le montant a été débité.</p>
                        </td>
                    {% else %}
                        <td style="background-color:#374151; padding:32px 24px; text-align:center;">
                            <h1 style="margin:0; font-size:26px; color:#ffffff;">Contestation clôturée</h1>
                            <p style="margin:12px 0 0; font-size:15px; color:#d1d5db;">La contestation a été fermée sans impact financier.</p>
                        </td>
                    {% endif %}
                </tr>
                <tr>
                    <td class="section-padding">

                        <div class="box">
                            <div class="box-title">Résultat</div>
                            <table role="presentation" width="100%">
                                <tr>
                                    <td class="cell cell-muted" width="40%">ID contestation</td>
                                    <td class="cell text-right">{{ dispute_id }}</td>
                                </tr>
                                <tr>
                                    <td class="cell cell-muted">Statut</td>
                                    <td class="cell text-right">
                                        {% if status == 'won' %}
                                            <span class="badge badge-green">Gagnée</span>
                                        {% elseif status == 'lost' %}
                                            <span class="badge badge-red">Perdue</span>
                                        {% else %}
                                            <span class="badge badge-gray">{{ status }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="box">
                            <div class="box-title">Commande concernée</div>
                            <table role="presentation" width="100%">
                                <tr>
                                    <td class="cell cell-muted" width="40%">Référence</td>
                                    <td class="cell text-right">{{ order.orderReference ?? '#' ~ order.id }}</td>
                                </tr>
                                <tr>
                                    <td class="cell cell-muted">Client</td>
                                    <td class="cell text-right">{{ order.user ? order.user.email : 'Inconnu' }}</td>
                                </tr>
                                <tr>
                                    <td class="cell cell-muted">Montant</td>
                                    <td class="cell text-right">{{ (order.orderTotalTtcCents / 100)|number_format(2, ',', ' ') }} €</td>
                                </tr>
                            </table>
                        </div>

                        <p style="margin-top:24px; font-size:13px; color:#6b7280; text-align:center;">
                            Consultez le <a href="https://dashboard.stripe.com/disputes" style="color:#6d28d9;">Dashboard Stripe</a> pour les détails.
                        </p>

                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
