{% extends 'base.html.twig' %}

{% block title %}{{globalSetting.website_name}} | Page error
{% endblock %}

{% block body %}
	{% include "page_head/index.html.twig" with {'page_name': "Page not found"} %}

	<!-- START MAIN CONTENT -->
	<div
		class="main_content">

		<!-- START 404 SECTION -->
		<div class="section">
			<div class="error_wrap">
				<div class="container">
					<div class="row align-items-center justify-content-center">
						<div class="col-lg-6 col-md-10 order-lg-first">
							<div class="text-center">
								<div class="error_txt">404</div>
								<h5 class="mb-2 mb-sm-3">oops! La page que vous avez demandée est introuvable !</h5>
								<p>La page que vous recherchez a été déplacée, supprimée, renommée ou n'a peut-être jamais existé.</p>

								<a href="/" class="btn btn-fill-out">Retour à l'accueil</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- END 404 SECTION -->

	</div>


{% endblock %}

