{% extends 'base.html.twig' %}

{% block title %}
	Acheter du miel naturel en ligne |
	{{ globalSetting.website_name }}
{% endblock %}

{% block stylesheets %}
	{% set heroVideo = globalSetting.hero_video_filename ?? null %}
	{% set heroPoster = globalSetting.hero_poster_filename ?? null %}
	{% if heroVideo %}
		{% if heroPoster %}
			{# Poster = LCP réel, préchargement prioritaire #}
			<link rel="preload" as="image" href="/assets/images/hero/{{ heroPoster }}" fetchpriority="high">
		{% else %}
			{# Sans poster, précharger la vidéo #}
			<link rel="preload" as="video" href="/assets/videos/hero/{{ heroVideo }}" type="video/mp4">
		{% endif %}
	{% elseif sliders|length > 0 %}
		{# Préchargement de l'image LCP (1ère slide du carousel) #}
		<link rel="preload" as="image" href="/assets/images/sliders/{{ sliders[0].mediaSlider }}" fetchpriority="high">
	{% endif %}
{% endblock %}

{% block body %}

	<main id="main-content">
		{% set heroVideo = globalSetting.hero_video_filename ?? null %}
		<section class="banner_section slide_medium shop_banner_slider staggered-animation-wrap" aria-label="Mise en avant des produits">

		{% if heroVideo %}
			{% set heroPoster = globalSetting.hero_poster_filename ?? null %}
			<div class="slider-video-item">
				<video class="slider-video-bg" autoplay muted loop playsinline preload="auto" fetchpriority="high" aria-hidden="true"
					{% if heroPoster %}poster="/assets/images/hero/{{ heroPoster }}"{% endif %}>
					<source src="/assets/videos/hero/{{ heroVideo }}" type="video/mp4">
				</video>
				<div class="banner_slide_content">
					<div class="container">
						<div class="row">
							<div class="col-lg-7 col-9">
								<div class="banner_content overflow-hidden">
									<h1 class="staggered-animation animated slideInLeft" style="color:#fff;">
										{{ globalSetting.heroTitle ?: 'Acheter du miel naturel en ligne' }}
									</h1>
									{% set btnUrl  = globalSetting.heroButtonUrl  ?: '/boutique' %}
									{% set btnText = globalSetting.heroButtonText ?: 'Découvrir' %}
									<a class="mt-4 btn btn-fill-out rounded-0 text-uppercase" href="{{ btnUrl }}">
										{{ btnText }}
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		{% else %}
			<div id="carouselExampleControls" data-bs-ride="carousel" class="carousel slide carousel-fade light_arrow">
				<div class="carousel-inner">
					{% for slider in sliders %}
						<div class="{{ loop.first ? 'carousel-item background_bg active' : 'lazyload carousel-item background_bg' }}"
							{% if loop.first %}
								style="background-image: url('/assets/images/sliders/{{ slider.mediaSlider }}');"
							{% else %}
								data-img-src="/assets/images/sliders/{{ slider.mediaSlider }}"
							{% endif %}
							aria-label="Slide {{ loop.index }}">
							<div class="banner_slide_content">
								<div class="container">
									<div class="row">
										<div class="col-lg-7 col-9">
											<div class="banner_content overflow-hidden">

												{% if slider.title %}
													<p data-animation="slideInLeft" data-animation-delay="0.5s" class=" staggered-animation font-weight-light animated slideInLeft" style="animation-delay: 0.5s; opacity: 1;">
														{{ slider.title }}
													</p>
												{% endif %}

												{% if loop.first %}
													<h1 data-animation="slideInLeft" data-animation-delay="1s" class="staggered-animation animated slideInLeft" style="color: aliceblue; animation-delay: 1s; opacity: 1;">
														Acheter du miel naturel en ligne
													</h1>
												{% else %}
													{% if slider.description %}
														<p data-animation="slideInLeft" data-animation-delay="1s" class="h2 mb-3 staggered-animation animated slideInLeft banner_main_text" style="color: aliceblue; animation-delay: 1s; opacity: 1;">
															{{ slider.description|striptags }}
														</p>
													{% endif %}
												{% endif %}

												<a data-animation="slideInLeft" data-animation-delay="1.5s" class="mt-4 btn btn-fill-out rounded-0 staggered-animation text-uppercase animated slideInLeft" href="{{ slider.buttonLink }}" style="animation-delay: 1.5s; opacity: 1;">
													{{ slider.buttonText }}
												</a>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>

				<a href="#carouselExampleControls" role="button" data-bs-slide="prev" class="carousel-control-prev" aria-label="Slide précédent">
					<svg class="icon" aria-hidden="true"><use href="#icon-chevron-left"></use></svg>
				</a>

				<a href="#carouselExampleControls" role="button" data-bs-slide="next" class="carousel-control-next" aria-label="Slide suivant">
					<svg class="icon" aria-hidden="true"><use href="#icon-chevron-right"></use></svg>
				</a>
			</div>
		{% endif %}
		</section>

		<section class="main_content" aria-labelledby="home-products-title">
			<div class="section small_pt pb_70">
				<div class="container">
					<div class="row justify-content-center">
						<div class="col-md-10 col-lg-8">
							<div class="heading_s1 text-center">
								<h2 id="home-products-title">Notre sélection de miels naturels</h2>
								<p>
									Retrouvez sur notre boutique une sélection de miels naturels choisis avec exigence.
									Que vous recherchiez un miel au goût délicat, intense ou plus boisé, nous vous proposons
									des produits de qualité pour acheter du miel en ligne en toute confiance.
								</p>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="col-12">
							<div class="tab-style1">
								<ul role="tablist" class="nav nav-tabs justify-content-center" aria-label="Filtres produits">
									<li class="nav-item" role="presentation">
										<a id="all-tab" data-bs-toggle="tab" href="#all" role="tab" aria-controls="all" aria-selected="true" class="nav-link active">
											Tous les produits
										</a>
									</li>
									<li class="nav-item" role="presentation">
										<a id="arrival-tab" data-bs-toggle="tab" href="#arrival" role="tab" aria-controls="arrival" aria-selected="false" class="nav-link">
											Nouveautés
										</a>
									</li>
									<li class="nav-item" role="presentation">
										<a id="sellers-tab" data-bs-toggle="tab" href="#sellers" role="tab" aria-controls="sellers" aria-selected="false" class="nav-link">
											Incontournables
										</a>
									</li>
								</ul>
							</div>

							<div class="tab-content">
								<div id="all" role="tabpanel" aria-labelledby="all-tab" class="tab-pane fade show active">
									<div class="row shop_container">
										{% for product in productAll %}
											{% include 'product/display_product.html.twig' %}
										{% else %}
											<div class="col-12">
												<p class="text-center">Aucun produit disponible pour le moment.</p>
											</div>
										{% endfor %}
									</div>
								</div>

								<div id="arrival" role="tabpanel" aria-labelledby="arrival-tab" class="tab-pane fade">
									<div class="row shop_container">
										{% for product in productNewArrival %}
											{% include 'product/display_product.html.twig' %}
										{% else %}
											<div class="col-12">
												<p class="text-center">Aucune nouveauté disponible pour le moment.</p>
											</div>
										{% endfor %}
									</div>
								</div>

								<div id="sellers" role="tabpanel" aria-labelledby="sellers-tab" class="tab-pane fade">
									<div class="row shop_container">
										{% for product in productBestSeller %}
											{% include 'product/display_product.html.twig' %}
										{% else %}
											<div class="col-12">
												<p class="text-center">Aucun produit incontournable disponible pour le moment.</p>
											</div>
										{% endfor %}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
        
        <section class="home-seo section pt-0 pb-50">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <h2 class="text-center mb-4">
                            Miels naturels et authentiques en ligne
                        </h2>

                        <p>
                            {{ globalSetting.website_name }} vous propose une sélection de miels naturels et authentiques venus des quatre coins du monde.
                            Chaque miel est choisi pour son origine, sa texture, son goût et la diversité de ses saveurs.
                        </p>

                        <p>
                            Que vous aimiez les miels doux, floraux, corsés ou plus typés, notre boutique en ligne vous permet
                            de découvrir différentes origines et d’acheter un miel adapté à vos préférences.
                        </p>

                        <p>
                            Acheter votre miel en ligne sur {{ globalSetting.website_name }}, c’est profiter d’une sélection soignée, de fiches produits claires
                            et d’une expérience d’achat simple pour trouver facilement le miel qui vous correspond.
                        </p>

                        <p class="mt-4 text-center">
                            <a href="{{ path('app_category', {categoryName: 'miels-fleurs'}) }}">Découvrir nos miels de fleurs</a>
                            -
                            <a href="{{ path('app_blog') }}">Lire nos conseils autour du miel</a>
                        </p>

                    </div>
                </div>
            </div>
        </section>


	</main>

{% endblock %}
