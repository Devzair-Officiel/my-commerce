{% extends 'checkout.html.twig' %}

{% block title %}Miel World | check!
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer"/>
	<link rel="stylesheet" href="/assets/css/stripe.css">
	<script src="https://www.paypal.com/sdk/js?client-id={{ paypal_public_key }}&currency=EUR"></script>
	<script src="https://js.stripe.com/v3/"></script>
{% endblock %}

{% block body %}

	{# Total produits (somme des quantités) #}
	{% set total_products = 0 %}
	{% for item in cart.items %}
		{% set total_products = total_products + (item.quantity ?? 0) %}
	{% endfor %}

	<div class="main_content" data-stripe_public_key="{{ stripe_public_key }}" data-paypal_public_key="{{ paypal_public_key }}" data-cart="{{ cart_json|e('html_attr') }}" data-orderid="{{ orderId }}">

		<div class="section">
			<div class="container">
				<div class="row">
					<div class="col-12 mb-3">
						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
							<h3 class="mb-0">Checkout</h3>
							<div class="badge bg-light text-dark border">
								{{ total_products }}
								produit
								{% if total_products > 1 %}s
								{% endif %}
								dans le panier
							</div>
						</div>
						<hr>
					</div>
				</div>

				<div
					class="row">
					{# COL GAUCHE #}
					<div class="col-md-6">
						<div class="heading_s1 mb-3">
							<h4>Adresse de livraison</h4>
							<label class="visually-hidden" for="shipping_address">Adresse de livraison</label>
							<select id="shipping_address" name="shipping_address" class="form-control" required>
								<option value="">--- Choisir l'adresse de livraison ---</option>
								{% for address in addresses %}
									{# IMPORTANT: on met une value stable (id) plutôt qu'un texte #}
									<option value="{{ address.id }}">
										{{ address.clientName }}
										({{ address.street }}
										{{ address.codePostal }}
										{{ address.city }}
										{{ address.state }})
									</option>
								{% endfor %}
							</select>
						</div>

						<div class="heading_s1 mb-3">
							<h4>Adresse de facturation</h4>
							<label class="visually-hidden" for="billing_address">Adresse de facturation</label>
							<select id="billing_address" name="billing_address" class="form-control" required>
								<option value="">--- Choisir l'adresse de facturation ---</option>
								{% for address in addresses %}
									<option value="{{ address.id }}">
										{{ address.clientName }}
										({{ address.street }}
										{{ address.codePostal }}
										{{ address.city }}
										{{ address.state }})
									</option>
								{% endfor %}
							</select>
						</div>

						<div class="heading_s1 mb-3">
							<h4>Commentaire</h4>
							<label class="visually-hidden" for="comment">Commentaire</label>
							<textarea class="form-control" name="comment" id="comment" cols="30" rows="6" maxlength="2000" placeholder="(Optionnel) Indications pour la livraison..."></textarea>
							<small class="text-muted">2000 caractères max.</small>
						</div>
					</div>

					{# COL DROITE #}
					<div class="col-md-6">
						<div class="order_review">
							<div class="heading_s1 d-flex justify-content-between align-items-center">
								<h4 class="mb-0">Votre commande</h4>
								<span class="text-muted small">{{ total_products }}
									article{% if total_products > 1 %}s{% endif %}
								</span>
							</div>

							<div class="table-responsive order_table mt-3">
								<table class="table">
									<thead>
										<tr>
											<th>Produit</th>
											<th class="text-end">Total</th>
										</tr>
									</thead>
									<tbody>
										{% for item in cart.items %}
											{% set unit_price_cents = item.product.soldePrice ?? item.product.regularPrice ?? 0 %}
											<tr>
												<td>
													<div class="d-flex align-items-center gap-2">
														<img src="/assets/images/products/{{ item.product.image[0] }}" width="36" height="36" loading="lazy" alt="{{ item.product.title|e }}"/>
														<div>
															<div class="fw-semibold">{{ item.product.title }}</div>
															<div class="small text-muted">
																<span class="product-qty">{{ item.quantity }}</span>
																×
																<span class="product-price">{{ (unit_price_cents / 100)|format_currency('EUR') }}</span>
															</div>
														</div>
													</div>
												</td>
												<td class="text-end">
													{{ (unit_price_cents * item.quantity / 100)|format_currency('EUR') }}
												</td>
											</tr>
										{% endfor %}
									</tbody>

									<tfoot>
										<tr>
											<th>Sous-total HT</th>
											<td class="text-end">{{ (cart.sub_total_ht / 100)|format_currency('EUR') }}</td>
										</tr>
										<tr>
											<th>TVA</th>
											<td class="text-end">{{ (cart.taxe / 100)|format_currency('EUR') }}</td>
										</tr>
										<tr>
											{% if cart.sub_total_ht > 5000 %}
												<th>Livraison offerte</th>
												<td class="text-end">{{ (cart.carrier.price / 100)|format_currency('EUR') }}</td>
											{% else %}
												<th>Frais de livraison</th>
												<td class="text-end">{{ (cart.carrier.price / 100)|format_currency('EUR') }}</td>
											{% endif %}
										</tr>
										<tr>
											<th>Total TTC</th>
											<td class="text-end fw-bold">
												{{ (cart.sub_total_with_carrier / 100)|format_currency('EUR') }}
											</td>
										</tr>
									</tfoot>
								</table>
							</div>

							{# Zone message #}
							<div class="alert alert-info mt-2 mb-0" role="status">
								Sélectionne une adresse de livraison et de facturation pour afficher le bouton de paiement.
							</div>

							<div class="payment-button d-none m-2">
								<a href="#" class="btn btn-fill-out btn-block" type="button" data-bs-toggle="modal" data-bs-target="#staticBackdrop" aria-controls="staticBackdrop">
									Payer maintenant —
									{{ (cart.sub_total_with_carrier / 100)|format_currency('EUR') }}
								</a>
							</div>
						</div>
					</div>
				</div>
				{# /row #}
			</div>
			{# /container #}
		</div>
		{# /section #}
	</div>
	{# /main_content #}

	<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title visually-hidden" id="staticBackdropLabel">Paiement</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<div class="modal-body">
					<div class="payment-methods d-flex gap-2 justify-content-center align-items-center mb-3" aria-label="Choix du moyen de paiement">
						<span>Stripe</span>
						<i class="fa-solid fa-toggle-off" role="button" aria-label="Basculer vers PayPal" tabindex="0"></i>
						<span>PayPal</span>
					</div>

					<div id="stripe-method">
						<form id="payment-form">
							<div id="link-authentication-element"></div>
							<div id="payment-element"></div>

							<button id="submit" type="submit">
								<div class="spinner hidden" id="spinner"></div>
								<span id="button-text">Payer maintenant</span>
							</button>

							<div id="payment-message" class="hidden" aria-live="polite"></div>
						</form>
					</div>

					<div id="paypal-method" class="d-none">
						<div id="paypal-button-container"></div>
						<p id="result-message" aria-live="polite"></p>
					</div>
				</div>
			</div>
		</div>
	</div>

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('assets/js/pages/checkout/stripe.js') }}" type="module" defer></script>
	<script src="{{ asset('assets/js/pages/checkout/paypal.js') }}" type="module" defer></script>
{% endblock %}

