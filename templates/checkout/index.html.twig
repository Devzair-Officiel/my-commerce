{% extends 'checkout.html.twig' %}

{% block title %}Miel World | check!{% endblock %}

{% block stylesheets %}
	{# Font Awesome supprimé — icônes migrées vers SVG sprite Lucide #}
	<link rel="stylesheet" href="/assets/css/stripe.css">
	<link rel="preload" href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" as="style" onload="this.rel='stylesheet'">
	<noscript><link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet"></noscript>
	<style>
		/* ── Address cards ──────────────────────────────────── */
		.address-card-item {
			border: 2px solid #e5e7eb;
			border-radius: 10px;
			padding: 14px 16px;
			cursor: pointer;
			display: flex;
			align-items: flex-start;
			gap: 12px;
			transition: border-color .15s, background .15s, box-shadow .15s;
			background: #fff;
			margin-bottom: 10px;
			outline: none;
		}
		.address-card-item:hover {
			border-color: #adb5bd;
			box-shadow: 0 2px 8px rgba(0,0,0,.08);
		}
		.address-card-item--active {
			border-color: #0d6efd;
			background: #f0f5ff;
			box-shadow: 0 0 0 3px rgba(13,110,253,.12);
		}
		.address-card-icon {
			width: 26px;
			height: 26px;
			border-radius: 50%;
			border: 2px solid #dee2e6;
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			margin-top: 2px;
			color: transparent;
			transition: all .15s;
		}
		.address-card-item--active .address-card-icon {
			background: #0d6efd;
			border-color: #0d6efd;
			color: #fff;
		}
		.address-card-name {
			font-weight: 600;
			font-size: 14px;
			color: #1a1a1a;
		}
		.address-card-details {
			font-size: 13px;
			color: #6b7280;
			line-height: 1.5;
			margin-top: 3px;
		}

		/* ── Colissimo modal ────────────────────────────────── */
		/*
		 * Le widget injecte .widget_colissimo_contenu { width:1000px; height:574px; box-sizing:content-box }
		 * La modal doit faire ≥ 1002px. Sur écrans plus étroits : scroll horizontal.
		 */
		#colissimo-modal .modal-dialog {
			width: 1040px;
			max-width: 98vw;
			margin: 10px auto;
		}
		#colissimo-modal .modal-content {
			border: none;
			border-radius: 10px;
			overflow: hidden;
			box-shadow: 0 20px 60px rgba(0,0,0,.22);
		}
		#colissimo-modal .modal-header {
			background: #fff;
			border-bottom: 1px solid #e8e8e8;
			padding: 10px 16px;
			flex-shrink: 0;
		}
		#colissimo-modal .modal-header .modal-title {
			font-size: 14px;
			font-weight: 700;
		}
		#colissimo-modal .modal-body {
			padding: 0 !important;
			overflow-x: auto;
			overflow-y: hidden;
			height: 576px;
			background: #fff;
		}
		#colissimo-widget-container {
			min-width: 1000px;
			line-height: normal;
		}

		/*
		 * ── Personnalisation officielle Colissimo (doc §2.9) ──────────────────
		 * .couleur1 → markers, bouton validation, bordure gauche point sélectionné
		 * .couleur2 → filtres accessibilité
		 * .police   → police de caractères
		 * Le widget lit ces classes CSS au démarrage via colissimo(".couleur1").css('color')
		 */
		.couleur1 { color: #E87722; }
		.couleur2 { color: #E87722; }
		.police   { font-family: inherit; }

		/*
		 * ── Overrides CSS widget — on préfixe avec #colissimo-widget-container
		 *    pour avoir une spécificité supérieure au <style> injecté par le plugin
		 * ─────────────────────────────────────────────────────────────────────
		 */

		/* Supprime la bordure externe (déjà dans la modal Bootstrap) */
		#colissimo-widget-container .widget_colissimo_contenu {
			border: none !important;
			margin: 0 !important;
		}

		/* Bouton "Me livrer à cette adresse" — texte centré, taille correcte */
		#colissimo-widget-container .widget_colissimo_bouton_validation {
			width: 240px !important;
			height: 36px !important;
			border-radius: 20px !important;
			padding-left: 0 !important;
			padding-right: 0 !important;
			padding-top: 0 !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			margin: 16px auto !important;
			cursor: pointer !important;
		}
		#colissimo-widget-container .widget_colissimo_text_bouton {
			text-align: center !important;
			font-size: 13px !important;
			font-weight: 600 !important;
			padding: 0 !important;
			margin: 0 !important;
			line-height: 1 !important;
			white-space: nowrap !important;
		}

		/* Markers sur la carte — remplacés par l'image locale */
		#colissimo-widget-container .widget_colissimo_marker,
		#colissimo-widget-container .widget_colissimo_marker_S,
		#colissimo-widget-container .widget_colissimo_marker_relais,
		#colissimo-widget-container .widget_colissimo_marker_bureau-de-poste,
		#colissimo-widget-container .widget_colissimo_marker_consigne,
		#colissimo-widget-container .widget_colissimo_marker_voisin-relais {
			background-image: url('/assets/images/colissimo.png') !important;
			background-size: contain !important;
			background-repeat: no-repeat !important;
		}

		/* Masque le bouton close interne du widget (on a déjà le btn-close Bootstrap) */
		#colissimo-widget-container .widget_colissimo_close {
			display: none !important;
		}

		/* ── Bouton "Choisir un point relais" ───────────────── */
		#pickup-open-btn {
			background: none;
			border: 2px dashed #ccc;
			border-radius: 12px;
			cursor: pointer;
			width: 100%;
			padding: 16px;
			display: flex;
			align-items: center;
			gap: 14px;
			transition: border-color .25s ease, background .25s ease, box-shadow .25s ease, transform .15s ease;
		}
		#pickup-open-btn:hover {
			border-color: #E87722;
			background: #fff8f3;
			box-shadow: 0 4px 16px rgba(232,119,34,.12);
			transform: translateY(-1px);
		}
		#pickup-open-btn:active {
			transform: translateY(0);
			box-shadow: none;
		}
		#pickup-open-btn .pickup-btn-chevron {
			transition: transform .25s ease;
		}
		#pickup-open-btn:hover .pickup-btn-chevron {
			transform: translateX(4px);
		}

		/* ── Adresse point relais sélectionné ───────────────── */
		.pickup-selected {
            margin: auto;
            padding: 7px 14px;
		}


		/* ── Carrier options ────────────────────────────────── */
		.carrier-option {
			transition: border-color .15s, background .15s;
		}
		.carrier-option--active {
			border-color: #0d6efd !important;
			background: #f0f5ff;
		}

		/* ── Section headings ───────────────────────────────── */
		.checkout-section-title {
			font-size: 15px;
			font-weight: 700;
			color: #374151;
			margin-bottom: 12px;
			display: flex;
			align-items: center;
			gap: 8px;
		}
		.checkout-section-title::after {
			content: '';
			flex: 1;
			height: 1px;
			background: #e5e7eb;
		}
        
	</style>
{% endblock %}

{% block csrf_meta %}
	<meta name="csrf-token-address" content="{{ csrf_token('address_api') }}">
{% endblock %}

{% block body %}
	{% set total_products = 0 %}
	{% for item in cart.items %}
		{% set total_products = total_products + (item.quantity ?? 0) %}
	{% endfor %}

	<div
		class="main_content"
		data-stripe-public-key="{{ stripe_public_key }}"
		data-cart="{{ cart_json|e('html_attr') }}"
		data-orderid="{{ orderId }}"
		data-colissimo-token="{{ colissimo_token }}"
		data-colissimo-zipcode="{{ addresses|first ? addresses|first.codePostal : '' }}"
		data-colissimo-city="{{ addresses|first ? addresses|first.city : '' }}"
		data-address-api="{{ address_api }}"
		data-address-csrf="{{ csrf_token('address_api') }}"
		data-countries-url="{{ asset('assets/data/countries.json') }}"
	>
		<div class="section">
			<div class="container">
				<div class="row">
					<div class="col-12 mb-3">
						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
							<a href="{{ path('app_cart') }}" class="btn btn-outline-secondary btn-sm" aria-label="Revenir au panier">
								<svg class="icon me-1" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
								Revenir au panier
							</a>

							<div class="d-flex align-items-center gap-2 flex-wrap">
								<h3 class="mb-0">Checkout</h3>
							</div>

							<div class="badge bg-light text-dark border">
								{{ total_products }} produit{% if total_products > 1 %}s{% endif %} dans le panier
							</div>
						</div>
						<hr>
					</div>
				</div>

				<div class="row">
					<div class="col-md-6">

						{# ── Mode de livraison ──────────────────────────────── #}
						{% if carriers|length > 0 %}
						<div class="mb-3">
							<div class="checkout-section-title {% if carriers|length == 1 %}d-none{% endif %}">
								<svg class="icon" aria-hidden="true" style="color:#6b7280; width:13px; height:13px;"><use href="#icon-truck"></use></svg>
								Mode de livraison
							</div>
							<div class="carrier-list {% if carriers|length == 1 %}d-none{% endif %}" role="radiogroup" aria-label="Mode de livraison">
								{% for carrier in carriers %}
									<label class="carrier-option d-flex align-items-center gap-3 p-3 border rounded mb-2"
										   style="cursor:pointer"
										   data-carrier-id="{{ carrier.id }}"
										   data-has-pickup="{{ carrier.hasPickupPoints() ? 'true' : 'false' }}"
										   data-price="{{ carrier.price }}">
										<input type="radio" name="carrier" value="{{ carrier.id }}" class="carrier-radio">
										<div class="flex-grow-1 d-flex align-items-center gap-2">
											{% if carrier.hasPickupPoints() %}
												<img src="https://www.colissimo.fr/favicon.ico" alt="Colissimo" width="20" height="20" style="flex-shrink:0;">
											{% endif %}
											<div>
												<div class="fw-semibold">{{ carrier.name }}</div>
												{% if carrier.deliveryDelay %}
													<div class="text-muted small">{{ carrier.deliveryDelay }}</div>
												{% endif %}
											</div>
										</div>
										<div class="fw-bold text-nowrap">
											{% if carrier.price == 0 or cart.sub_total >= cart.free_shipping_threshold %}
												<span class="text-success">Offert</span>
											{% else %}
												{{ (carrier.price / 100)|format_currency('EUR') }}
											{% endif %}
										</div>
									</label>
								{% endfor %}
							</div>

							{# ── Point relais — juste sous la liste des transporteurs ── #}
							<div id="pickup-point-section" class="mt-2 d-none">

								{# Bouton d'ouverture du widget #}
								<div id="pickup-open-btn-wrapper">
									<button type="button" id="pickup-open-btn">
										<img src="https://www.colissimo.fr/favicon.ico" alt="Colissimo" width="30" height="30" style="flex-shrink:0;">
										<div style="text-align:left; flex:1;">
											<div style="font-weight:600; font-size:14px; color:#222;">Choisir un point relais Colissimo</div>
											<div style="font-size:12px; color:#888; margin-top:2px;">Bureaux de poste, relais commerçants…</div>
										</div>
										<svg class="icon pickup-btn-chevron" aria-hidden="true" style="color:#aaa; width:12px; height:12px; flex-shrink:0;"><use href="#icon-chevron-right"></use></svg>
									</button>
								</div>

								{# Récapitulatif du point relais choisi #}
								<div id="pickup-selected" class="d-none">
									<div class="address-card-item address-card-item--active">
										<div id="pickup-selected-label"></div>
										<div type="button"  class="btn btn-fill-line pickup-selected">
											<svg class="icon" aria-hidden="true"><use href="#icon-pen"></use></svg> Changer de point de retrait
										</div>
									</div>
								</div>
							</div>
						</div>

						{# ── Téléphone requis pour point relais ───────────── #}
						<div id="pickup-phone-section" class="mb-3 d-none">
							<label for="pickup-phone" class="form-label fw-semibold" style="font-size:13px;">
								<svg class="icon me-1" aria-hidden="true" style="color:#6b7280;"><use href="#icon-phone"></use></svg>
								Numéro de portable <span class="text-danger">*</span>
								<span class="text-muted fw-normal" style="font-size:12px;">(requis pour recevoir le SMS d'arrivée)</span>
							</label>
							<input type="tel" id="pickup-phone" name="pickup_phone"
								   class="form-control form-control-sm"
								   placeholder="06 00 00 00 00"
								   inputmode="tel"
								   maxlength="20"
								   value="{{ app.user.phone ?? '' }}">
							<div id="pickup-phone-error" class="text-danger small mt-1 d-none">Veuillez saisir votre numéro de portable.</div>
						</div>

						{% endif %}

						{# ── Modale widget Colissimo ──────────────────────── #}
						<div id="colissimo-prefetch" aria-hidden="true" style="position:fixed;top:-9999px;left:-9999px;width:1000px;height:574px;overflow:hidden;pointer-events:none;">
							<div id="colissimo-widget-container"></div>
						</div>
						<div class="modal fade" id="colissimo-modal" tabindex="-1" aria-labelledby="colissimoModalLabel" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered">
								<div class="modal-content">
									<div class="modal-header">
										<div class="d-flex align-items-center gap-2">
											<img src="https://www.colissimo.fr/favicon.ico" alt="Colissimo" width="22" height="22">
											<div>
												<h5 class="modal-title mb-0" id="colissimoModalLabel">Choisir un point relais</h5>
												<div class="text-muted" style="font-size:11px; line-height:1.2;">Colissimo — La Poste</div>
											</div>
										</div>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
									</div>
									<div class="modal-body" id="colissimo-modal-body" style="min-height:400px; position:relative;">
										<div id="colissimo-loader" style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;z-index:10;gap:12px;">
											<div class="spinner-border text-warning" role="status" style="width:2.5rem;height:2.5rem;">
												<span class="visually-hidden">Chargement…</span>
											</div>
											<span class="text-muted small">Chargement de la carte…</span>
										</div>
									</div>
								</div>
							</div>
						</div>

						{# ── Adresse de livraison (mode domicile) ─────────── #}
						<div id="shipping-address-section" class="mb-4">
							<div class="checkout-section-title">
								<svg class="icon" aria-hidden="true" style="color:#6b7280; width:13px; height:13px;"><use href="#icon-location"></use></svg>
								Adresse de livraison
							</div>

							{# Select caché — utilisé par le JS pour lire la valeur #}
							<select id="shipping_address" name="shipping_address" class="d-none" aria-hidden="true">
								<option value=""></option>
								{% for address in addresses %}
									<option value="{{ address.id }}">{{ address.clientName }}</option>
								{% endfor %}
							</select>

							{% if addresses|length == 0 %}
								<div class="alert alert-warning mt-2" role="status">
									Vous n'avez aucune adresse enregistrée. Ajoutez-en une pour continuer.
								</div>
							{% endif %}

							{# Cartes adresses #}
							<div id="shipping-address-cards">
								{% for address in addresses %}
									<div class="address-card-item" data-address-id="{{ address.id }}" role="button" tabindex="0" aria-label="{{ address.clientName }}, {{ address.street }}, {{ address.codePostal }} {{ address.city }}">
										<div class="address-card-icon">
											<svg class="icon" aria-hidden="true" style="width:11px; height:11px;"><use href="#icon-check"></use></svg>
										</div>
										<div>
											<div class="address-card-name">{{ address.clientName }}</div>
											<div class="address-card-details">
												{{ address.street }}{% if address.moreDetails %}, {{ address.moreDetails }}{% endif %}<br>
												{{ address.codePostal }} {{ address.city }}<br>
												{{ address.state }}
											</div>
										</div>
									</div>
								{% endfor %}
							</div>

							<div class="mt-2">
								<a href="#" class="btn btn-outline-secondary btn-sm" id="checkout-add-address-btn">
									<svg class="icon me-1" aria-hidden="true"><use href="#icon-plus"></use></svg>Ajouter une adresse de livraison
								</a>
							</div>

							<div id="checkout-add-address-form" class="card mt-3 d-none border-0 shadow-sm">
								<div class="card-body">
									<h6 class="card-title mb-3 fw-bold">Nouvelle adresse</h6>

									<form id="checkoutAddressForm">
										<div class="row g-3">
											<input type="hidden" name="address_type" value="livraison">

											<div class="form-group col-md-12">
												<label class="form-label small fw-semibold">Nom de l'adresse <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm" name="name" type="text">
											</div>

											<div class="form-group col-md-12">
												<label class="form-label small fw-semibold">Nom du destinataire <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm" name="client_name" type="text">
											</div>

											<div class="form-group col-md-8">
												<label class="form-label small fw-semibold">Rue <span class="text-danger">*</span></label>
												<div class="position-relative">
													<input required class="form-control form-control-sm address-street-input" name="street" type="text" autocomplete="off" placeholder="Commencez à taper votre adresse…">
													<ul class="address-suggestions list-unstyled" role="listbox" aria-label="Suggestions d'adresse"></ul>
												</div>
											</div>

											<div class="form-group col-md-4">
												<label class="form-label small fw-semibold">Code postal <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm address-code-postal-input" name="code_postal" type="text" inputmode="numeric" maxlength="10">
											</div>

											<div class="form-group col-md-8">
												<label class="form-label small fw-semibold">Ville <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm address-city-input" name="city" type="text">
											</div>

											<div class="form-group col-md-4">
												<label class="form-label small fw-semibold">Pays <span class="text-danger">*</span></label>
												<select class="form-select form-select-sm" name="state" id="checkout-state" required></select>
											</div>

											<div class="form-group col-md-12">
												<label class="form-label small fw-semibold">Complément (optionnel)</label>
												<input class="form-control form-control-sm" name="more_details" type="text" maxlength="500">
											</div>

											<div class="col-md-12 d-flex gap-2">
												<button type="submit" class="btn btn-fill-out btn-sm">Enregistrer</button>
												<button type="button" class="btn btn-outline-secondary btn-sm" id="checkout-cancel-address">
													Annuler
												</button>
											</div>
										</div>
									</form>
								</div>
							</div>
						</div>{# fin shipping-address-section #}

						{# ── Adresse de facturation ──────────────────────── #}
						<div class="mb-4">
							<div class="checkout-section-title">
								<svg class="icon" aria-hidden="true" style="color:#6b7280; width:13px; height:13px;"><use href="#icon-file"></use></svg>
								Adresse de facturation
							</div>

							{# Select caché — utilisé par le JS pour lire la valeur #}
							<select id="billing_address" name="billing_address" class="d-none" aria-hidden="true">
								<option value=""></option>
								{% for address in addresses %}
									<option value="{{ address.id }}">{{ address.clientName }}</option>
								{% endfor %}
							</select>

							{% if addresses|length == 0 %}
								<div class="alert alert-warning mt-2" role="status">
									Vous n'avez aucune adresse enregistrée. Ajoutez-en une pour continuer.
								</div>
							{% endif %}

							{# Cartes adresses #}
							<div id="billing-address-cards">
								{% for address in addresses %}
									<div class="address-card-item" data-address-id="{{ address.id }}" role="button" tabindex="0" aria-label="{{ address.clientName }}, {{ address.street }}, {{ address.codePostal }} {{ address.city }}">
										<div class="address-card-icon">
											<svg class="icon" aria-hidden="true" style="width:11px; height:11px;"><use href="#icon-check"></use></svg>
										</div>
										<div>
											<div class="address-card-name">{{ address.clientName }}</div>
											<div class="address-card-details">
												{{ address.street }}{% if address.moreDetails %}, {{ address.moreDetails }}{% endif %}<br>
												{{ address.codePostal }} {{ address.city }}<br>
												{{ address.state }}
											</div>
										</div>
									</div>
								{% endfor %}
							</div>

							<div class="mt-2">
								<a href="#" class="btn btn-outline-secondary btn-sm" id="checkout-add-billing-btn">
									<svg class="icon me-1" aria-hidden="true"><use href="#icon-plus"></use></svg>Ajouter une adresse de facturation
								</a>
							</div>

							<div id="checkout-add-billing-form" class="card mt-3 d-none border-0 shadow-sm">
								<div class="card-body">
									<h6 class="card-title mb-3 fw-bold">Nouvelle adresse de facturation</h6>

									<form id="checkoutBillingAddressForm">
										<div class="row g-3">
											<div class="form-group col-md-12">
												<label class="form-label small fw-semibold">Nom de l'adresse <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm" name="name" type="text">
											</div>

											<div class="form-group col-md-12">
												<label class="form-label small fw-semibold">Nom du destinataire <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm" name="client_name" type="text">
											</div>

											<div class="form-group col-md-8">
												<label class="form-label small fw-semibold">Rue <span class="text-danger">*</span></label>
												<div class="position-relative">
													<input required class="form-control form-control-sm address-street-input" name="street" type="text" autocomplete="off" placeholder="Commencez à taper votre adresse…">
													<ul class="address-suggestions list-unstyled" role="listbox" aria-label="Suggestions d'adresse"></ul>
												</div>
											</div>

											<div class="form-group col-md-4">
												<label class="form-label small fw-semibold">Code postal <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm address-code-postal-input" name="code_postal" type="text" inputmode="numeric" maxlength="10">
											</div>

											<div class="form-group col-md-8">
												<label class="form-label small fw-semibold">Ville <span class="text-danger">*</span></label>
												<input required class="form-control form-control-sm address-city-input" name="city" type="text">
											</div>

											<div class="form-group col-md-4">
												<label class="form-label small fw-semibold">Pays <span class="text-danger">*</span></label>
												<select class="form-select form-select-sm" name="state" id="checkout-billing-state" required></select>
											</div>

											<div class="form-group col-md-12">
												<label class="form-label small fw-semibold">Complément (optionnel)</label>
												<input class="form-control form-control-sm" name="more_details" type="text" maxlength="500">
											</div>

											<div class="col-md-12 d-flex gap-2">
												<button type="submit" class="btn btn-fill-out btn-sm">Enregistrer</button>
												<button type="button" class="btn btn-outline-secondary btn-sm" id="checkout-cancel-billing">
													Annuler
												</button>
											</div>
										</div>
									</form>
								</div>
							</div>
						</div>

						{# ── Commentaire ──────────────────────────────────── #}
						<div class="mb-4">
							<div class="checkout-section-title">
								<svg class="icon" aria-hidden="true" style="color:#6b7280; width:13px; height:13px;"><use href="#icon-message"></use></svg>
								Commentaire
							</div>
							<label class="visually-hidden" for="comment">Commentaire</label>
							<textarea
								class="form-control"
								name="comment"
								id="comment"
								rows="4"
								maxlength="2000"
								placeholder="(Optionnel) Indications pour la livraison…"
							></textarea>
							<small class="text-muted">2000 caractères max.</small>
						</div>
					</div>

					<div class="col-md-6">
						<div class="order_review">
							<div class="heading_s1 d-flex justify-content-between align-items-center">
								<h4 class="mb-0">Votre commande</h4>
								<span class="text-muted small">
									{{ total_products }} article{% if total_products > 1 %}s{% endif %}
								</span>
							</div>

							<div class="table-responsive order_table mt-3">
								<table class="table">
									<thead>
										<tr>
											<th>Produit</th>
											<th class="text-end">Total</th>
										</tr>
									</thead>
									<tbody>
										{% for item in cart.items %}
											{% set unit_price_cents = item.product.soldePrice ?? item.product.regularPrice ?? 0 %}
											<tr>
												<td>
													<div class="d-flex align-items-center gap-2">
														<img
															src="/assets/images/products/{{ item.product.image[0].filename }}"
															width="36"
															height="36"
															loading="lazy"
															alt="{{ item.product.image[0].alt }}"
														/>
														<div>
															<div class="fw-semibold">{{ item.product.title }}</div>
															<div class="small text-muted">
																<span class="product-qty">{{ item.quantity }}</span>
																×
																<span class="product-price">{{ (unit_price_cents / 100)|format_currency('EUR') }}</span>
															</div>
														</div>
													</div>
												</td>
												<td class="text-end">
													{{ (unit_price_cents * item.quantity / 100)|format_currency('EUR') }}
												</td>
											</tr>
										{% endfor %}
									</tbody>

									<tfoot>
										<tr>
											<th>Sous-total HT</th>
											<td class="text-end">{{ (cart.sub_total_ht / 100)|format_currency('EUR') }}</td>
										</tr>
										<tr>
											<th>TVA</th>
											<td class="text-end">{{ (cart.taxe / 100)|format_currency('EUR') }}</td>
										</tr>
										<tr>
											<th id="checkout-shipping-label">
												{% if cart.carrier.free_shipping %}
													Livraison offerte
												{% else %}
													Frais de livraison
												{% endif %}
											</th>
											<td class="text-end" id="checkout-shipping-price">
												{% if cart.carrier.free_shipping %}
													Offert
												{% else %}
													{{ (cart.carrier.price / 100)|format_currency('EUR') }}
												{% endif %}
											</td>
										</tr>
										<tr>
											<th>Total TTC</th>
											<td class="text-end fw-bold" id="checkout-total">
												{{ (cart.sub_total_with_carrier / 100)|format_currency('EUR') }}
											</td>
										</tr>
									</tfoot>
								</table>
							</div>

							{% if not cart.carrier.free_shipping and cart.free_shipping_remaining > 0 %}
								<div class="alert alert-info mt-2" role="status">
									🎁 Livraison offerte dès 50 € d'achat — encore
									<strong>{{ (cart.free_shipping_remaining / 100)|format_currency('EUR') }}</strong>
								</div>
							{% endif %}

							<div class="alert alert-info mt-2 mb-0" id="checkout-hint" role="status">
								Complète les informations de livraison et de facturation pour afficher le bouton de paiement.
							</div>

							<div class="payment-button d-none">
								<button id="open-payment-modal" class="btn btn-fill-out btn-block" type="button">
									Payer maintenant — <span id="checkout-pay-total">{{ (cart.sub_total_with_carrier / 100)|format_currency('EUR') }}</span>
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div
		class="modal fade"
		id="staticBackdrop"
		data-bs-backdrop="static"
		data-bs-keyboard="false"
		tabindex="-1"
		aria-labelledby="staticBackdropLabel"
		aria-hidden="true"
	>
		<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title visually-hidden" id="staticBackdropLabel">Paiement</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>

				<div class="modal-body">
					<div id="stripe-method">
						<form id="payment-form">
							<div id="link-authentication-element"></div>
							<div id="payment-element"></div>

							<button id="submit" type="submit">
								<div class="spinner hidden" id="spinner"></div>
								<span id="button-text">Payer maintenant</span>
							</button>

							<div id="payment-message" class="hidden" aria-live="polite"></div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://js.stripe.com/v3/" defer></script>
	<script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js" defer></script>
	<script src="{{ asset('assets/js/modules/address-autocomplete.js') }}" defer></script>
	<script src="{{ asset('assets/js/pages/checkout/address.js') }}?v=3" type="module" defer></script>
	<script src="{{ asset('assets/js/pages/checkout/stripe.js') }}?v=3" type="module" defer></script>
{% endblock %}

{% block body_scripts %}
	<script src="https://ws.colissimo.fr/widget-colissimo/js/jquery.plugin.colissimo.js" defer></script>
{% endblock %}
