<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% block title %}Checkout{% endblock %}</title>
		{% if globalSetting is defined and globalSetting.favicon_filename is defined and globalSetting.favicon_filename %}
			<link rel="icon" type="image/png" href="/assets/images/setting/{{ globalSetting.favicon_filename }}" sizes="32x32">
			<link rel="shortcut icon" href="/assets/images/setting/{{ globalSetting.favicon_filename }}">
		{% else %}
			<link rel="icon" type="image/png" href="{{ asset('favicon/favicon-96x96.png') }}" sizes="96x96">
		{% endif %}

		<link rel="stylesheet" href="/assets/bootstrap/css/bootstrap.min.css"/>
		<link rel="stylesheet" href="/assets/css/style.refactor.css?v=1.1.3"/>
		<link rel="stylesheet" href="/assets/css/responsive.css"/>

		{% block stylesheets %}{% endblock %}
		{% block javascripts %}{% endblock %}
	</head>
	<body>

		{% include 'components/svg_sprite.html.twig' %}

		<div class="notification" id="notification-container" aria-live="polite" aria-atomic="true"></div>

		<div id="server-flashes" class="d-none" aria-hidden="true">
			{% for label, messages in app.flashes %}
				{% for message in messages %}
					<div class="server-flash" data-label="{{ label }}" data-message="{{ message }}"></div>
				{% endfor %}
			{% endfor %}
		</div>

		{% block body %}{% endblock %}

		<script src="/assets/js/jquery-3.6.0.min.js" defer></script>
		<script src="/assets/js/popper.min.js" defer></script>
		<script src="/assets/bootstrap/js/bootstrap.min.js" defer></script>
		<script src="/assets/js/waypoints.min.js" defer></script>
		<script src="/assets/js/scripts.js?v=1.1.2" defer></script>
		<script src="{{ asset('assets/js/utils/server-flashes.js') }}" type="module" defer></script>
		<script type="module" src="/assets/js/main.js?v=1.1.0"></script>
		{% block body_scripts %}{% endblock %}
	</body>
</html>
